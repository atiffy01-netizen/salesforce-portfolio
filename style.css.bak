/* ==========================================================================
   DEVELOPER PORTFOLIO — PREMIUM MODERN THEME
   Palette: Deep Navy Blue, White, Soft Purple, Electric Blue
   Supports: Dark Mode (Default) & Light Mode
   M. ATIF — PREMIUM PURPLE PORTFOLIO
   One permanent theme. Rich Purple identity. No dark/light toggle.
   Palette: #7C3AED · #5B21B6 · #A78BFA · #FAF9FF · #211B2D
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. CSS VARIABLES & THEME DEFINITIONS
   1. CSS CUSTOM PROPERTIES
   -------------------------------------------------------------------------- */
:root {
  /* Brand Constants */
  --electric-blue: #38bdf8;
  --electric-blue-hover: #0284c7;
  --electric-blue-rgb: 56, 189, 248;
  --electric-blue-soft: rgba(56, 189, 248, 0.12);
  --electric-blue-glow: rgba(56, 189, 248, 0.35);
  /* Brand */
  --purple: #7C3AED;
  --purple-dark: #5B21B6;
  --purple-deeper: #4C1D95;
  --purple-light: #A78BFA;
  --purple-pale: #EDE9FE;
  --purple-faint: #F5F3FF;

  --soft-purple: #a855f7;
  --soft-purple-light: #c084fc;
  --soft-purple-rgb: 168, 85, 247;
  --soft-purple-soft: rgba(168, 85, 247, 0.12);
  --soft-purple-glow: rgba(168, 85, 247, 0.3);
  /* Neutrals */
  --bg: #FAF9FF;
  --bg-alt: #F3F0FF;
  --surface: #FFFFFF;
  --text: #211B2D;
  --text-2: #4B4563;
  --text-3: #6B6387;
  --border: rgba(124, 58, 237, 0.14);
  --border-med: rgba(124, 58, 237, 0.28);

  --indigo-accent: #6366f1;
  --cyan-accent: #06b6d4;
  --emerald-accent: #10b981;
  /* Gradients */
  --grad-main: linear-gradient(135deg, #7C3AED 0%, #5B21B6 50%, #4C1D95 100%);
  --grad-soft: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(91, 33, 182, 0.06));
  --grad-glow: linear-gradient(135deg, #A78BFA 0%, #7C3AED 100%);
  --grad-section: linear-gradient(160deg, #7C3AED 0%, #5B21B6 100%);

  /* Typography */
  --font-display: 'Sora', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
  --font-display: 'Sora', 'Plus Jakarta Sans', -apple-system, sans-serif;
  --font-body: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;

  /* Border Radii */
  --radius-xs: 6px;
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  --radius-pill: 9999px;
  /* Spacing & radii */
  --r-sm: 8px;
  --r-md: 14px;
  --r-lg: 22px;
  --r-xl: 32px;
  --r-pill: 9999px;

  /* Shadows */
  --shadow-sm: 0 2px 10px rgba(124, 58, 237, 0.08);
  --shadow-md: 0 8px 28px rgba(124, 58, 237, 0.14);
  --shadow-lg: 0 20px 50px rgba(124, 58, 237, 0.20);
  --shadow-card: 0 4px 20px rgba(33, 27, 45, 0.07);

  /* Transitions */
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --transition-fast: 0.2s var(--ease);
  --transition-normal: 0.35s var(--ease);
  --transition-slow: 0.6s var(--ease);

  /* Gradients */
  --grad-signature: linear-gradient(135deg, #38bdf8 0%, #6366f1 52%, #a855f7 100%);
  --grad-signature-rev: linear-gradient(135deg, #a855f7 0%, #6366f1 48%, #38bdf8 100%);
  --grad-accent: linear-gradient(135deg, #0284c7 0%, #6366f1 100%);
  --grad-soft: linear-gradient(145deg, rgba(56, 189, 248, 0.08) 0%, rgba(168, 85, 247, 0.05) 100%);
  --grad-border: linear-gradient(135deg, rgba(56, 189, 248, 0.4), rgba(168, 85, 247, 0.25));

  /* DARK THEME (Default) */
  --bg-primary: #070b14;
  --bg-secondary: #0b1220;
  --bg-surface: #0f182e;
  --bg-card: rgba(13, 22, 42, 0.72);
  --bg-card-hover: rgba(18, 29, 56, 0.88);
  --bg-glass: rgba(7, 11, 20, 0.82);
  --bg-input: #0f1930;

  --border-subtle: rgba(148, 163, 184, 0.12);
  --border-card: rgba(56, 189, 248, 0.16);
  --border-card-hover: rgba(56, 189, 248, 0.45);
  --border-strong: rgba(148, 163, 184, 0.24);

  --text-primary: #f8fafc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --text-dim: #64748b;

  --shadow-card: 0 14px 34px -15px rgba(0, 0, 0, 0.6), 0 0 1px 1px rgba(255, 255, 255, 0.05);
  --shadow-card-hover: 0 24px 48px -18px rgba(56, 189, 248, 0.25), 0 0 25px rgba(168, 85, 247, 0.18);
  --shadow-btn: 0 10px 26px -8px rgba(56, 189, 248, 0.45);
  --shadow-nav: 0 10px 30px -15px rgba(0, 0, 0, 0.5);

  --mesh-opacity: 0.15;
  --grid-line-color: rgba(255, 255, 255, 0.035);
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-b: cubic-bezier(0.34, 1.56, 0.64, 1);
  --t-fast: 0.22s var(--ease);
  --t-mid: 0.4s var(--ease);
  --t-slow: 0.7s var(--ease);
}

/* --------------------------------------------------------------------------
   LIGHT THEME OVERRIDES
   2. RESET & BASE
   -------------------------------------------------------------------------- */
[data-theme="light"] {
  --bg-primary: #f8fafc;
  --bg-secondary: #f1f5f9;
  --bg-surface: #ffffff;
  --bg-card: rgba(255, 255, 255, 0.88);
  --bg-card-hover: #ffffff;
  --bg-glass: rgba(248, 250, 252, 0.85);
  --bg-input: #ffffff;

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
    font-size: 16px;
  }

  --border-subtle: rgba(15, 23, 42, 0.08);
  --border-card: rgba(15, 23, 42, 0.1);
  --border-card-hover: rgba(2, 132, 199, 0.4);
  --border-strong: rgba(15, 23, 42, 0.18);

  --text-primary: #0a0f1d;
  --text-secondary: #334155;
  --text-muted: #64748b;
  --text-dim: #94a3b8;

  --shadow-card: 0 14px 32px -15px rgba(15, 23, 42, 0.08),
  0 2px 6px -2px rgba(15, 23, 42, 0.04);
  --shadow-card-hover: 0 24px 48px -18px rgba(2, 132, 199, 0.22),
  0 4px 15px rgba(99, 102, 241, 0.1);
  --shadow-btn: 0 10px 24px -8px rgba(2, 132, 199, 0.4);
  --shadow-nav: 0 10px 30px -18px rgba(15, 23, 42, 0.12);

  --mesh-opacity: 0.08;
  --grid-line-color: rgba(15, 23, 42, 0.04);
  --electric-blue: #0284c7;
  --soft-purple: #7c3aed;
}

/* --------------------------------------------------------------------------
   2. RESET & BASE ELEMENTS
   -------------------------------------------------------------------------- */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  background-color: var(--bg-primary);
  color: var(--text-secondary);
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition: background-color var(--transition-normal), color var(--transition-normal);
  position: relative;
}

img,
svg {
  display: block;
  max-width: 100%;
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--t-fast);
}

ul,
ol {
  list-style: none;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

input,
textarea,
select {
  font-family: inherit;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-fast);
}

::selection {
  background: var(--purple);
  color: #fff;
}

:focus-visible {
  outline: 2px solid var(--purple);
  outline-offset: 3px;
  border-radius: 4px;
}

ul,
ol {
  list-style: none;
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg);
}

::-webkit-scrollbar-thumb {
  background: var(--purple-light);
  border-radius: var(--r-pill);
  border: 2px solid var(--bg);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--purple);
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

input,
textarea,
select {
  font-family: inherit;
}

::selection {
  background: var(--electric-blue);
  color: #ffffff;
}

:focus-visible {
  outline: 2px solid var(--electric-blue);
  outline-offset: 3px;
  border-radius: var(--radius-xs);
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--bg-primary);
}

::-webkit-scrollbar-thumb {
  background: rgba(148, 163, 184, 0.3);
  border-radius: var(--radius-pill);
  border: 2px solid var(--bg-primary);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--electric-blue);
}

/* --------------------------------------------------------------------------
   3. AMBIENT BACKGROUND & MESH EFFECTS
   3. LAYOUT UTILITIES
   -------------------------------------------------------------------------- */
.bg-ambient {
  position: fixed;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  overflow: hidden;
}

.mesh-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: var(--mesh-opacity);
  pointer-events: none;
}

.mesh-orb-1 {
  width: 600px;
  height: 600px;
  top: -150px;
  right: -100px;
  background: radial-gradient(circle, var(--electric-blue) 0%, transparent 70%);
  animation: floatOrb 22s ease-in-out infinite alternate;
}

.mesh-orb-2 {
  width: 650px;
  height: 650px;
  top: 30%;
  left: -200px;
  background: radial-gradient(circle, var(--soft-purple) 0%, transparent 70%);
  animation: floatOrb 28s ease-in-out infinite alternate-reverse;
}

.mesh-orb-3 {
  width: 500px;
  height: 500px;
  bottom: 5%;
  right: 5%;
  background: radial-gradient(circle, var(--indigo-accent) 0%, transparent 70%);
  animation: floatOrb 25s ease-in-out infinite alternate;
}

@keyframes floatOrb {
  0% {
    transform: translate(0, 0) scale(1);
  }

  50% {
    transform: translate(60px, 40px) scale(1.1);
  }

  100% {
    transform: translate(-40px, 70px) scale(0.95);
  }
}

.bg-grid {
  position: fixed;
  inset: 0;
  z-index: -1;
  background-image:
    linear-gradient(var(--grid-line-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-line-color) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 90% 60% at 50% 10%, black 10%, transparent 80%);
  pointer-events: none;
}

/* --------------------------------------------------------------------------
   4. LAYOUT & TYPOGRAPHY UTILITIES
   -------------------------------------------------------------------------- */
.container {
  width: 100%;
  max-width: 1220px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  padding: 0 28px;
}

section {
  padding: 110px 0;
  position: relative;
}

section {
  position: relative;
}

.section-head {
  max-width: 720px;
  margin-bottom: 56px;
}

.section-head.center {
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

.eyebrow {
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--electric-blue);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    background: var(--electric-blue-soft);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--purple);
    background: var(--purple-faint);
    border: 1px solid rgba(124, 58, 237, 0.22);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border-radius: var(--r-pill);
    margin-bottom: 16px;
  }

  .section-head.center .eyebrow {
    margin-left: auto;
    margin-right: auto;

    .section-eyebrow.light {
      color: #fff;
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .eyebrow i {
      font-size: 11px;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(30px, 4.2vw, 44px);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 700;
      color: var(--text-primary);
      color: var(--text);
      letter-spacing: -0.025em;
      line-height: 1.18;
    }

    .section-title.light {
      color: #fff;
    }

    .section-title em {
      font-style: normal;
      color: var(--purple);
    }

    .section-desc {
      .section-subtitle {
        margin-top: 14px;
        color: var(--text-muted);
        font-size: 16px;
        line-height: 1.65;
        color: var(--text-3);
        max-width: 580px;
      }

      .section-subtitle.light {
        color: rgba(255, 255, 255, 0.75);
      }

      .gradient-text {
        background: var(--grad-signature);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: inline-block;

        .section-head-center {
          text-align: center;
          margin-bottom: 56px;
        }

        .section-head-center .section-subtitle {
          margin-left: auto;
          margin-right: auto;
        }

        /* --------------------------------------------------------------------------
   5. BUTTONS & INTERACTIVE ELEMENTS
   -------------------------------------------------------------------------- */
        .btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          padding: 13px 26px;
          border-radius: var(--radius-md);
          font-size: 14.5px;
          font-weight: 600;
          transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
          cursor: pointer;
          position: relative;
          overflow: hidden;

          /* Scroll reveal */
          .reveal,
          .reveal-left,
          .reveal-right {
            opacity: 0;
            transition: opacity var(--t-slow), transform var(--t-slow);
          }

          .btn-primary {
            background: var(--grad-signature);
            color: #ffffff !important;
            box-shadow: var(--shadow-btn);
            border: 1px solid rgba(255, 255, 255, 0.15);

            .reveal {
              transform: translateY(32px);
            }

            .reveal-left {
              transform: translateX(-40px);
            }

            .reveal-right {
              transform: translateX(40px);
            }

            .reveal.in,
            .reveal-left.in,
            .reveal-right.in {
              opacity: 1;
              transform: translate(0);
            }

            .btn-primary::after {
              content: '';
              position: absolute;
              top: 0;
              left: -100%;
              width: 60%;
              height: 100%;
              background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
              transform: skewX(-25deg);
              transition: left 0.6s var(--ease);
              pointer-events: none;
            }

            .btn-primary:hover {
              transform: translateY(-3px);
              box-shadow: 0 16px 36px -10px rgba(56, 189, 248, 0.55), 0 0 20px rgba(168, 85, 247, 0.35);
            }

            .btn-primary:hover::after {
              left: 140%;
            }

            .btn-secondary {
              background: var(--bg-card);
              border: 1.5px solid var(--border-strong);
              color: var(--text-primary);
              backdrop-filter: blur(10px);
            }

            .btn-secondary:hover {
              border-color: var(--electric-blue);
              background: var(--electric-blue-soft);
              color: var(--electric-blue);
              transform: translateY(-3px);
              box-shadow: 0 12px 28px -12px rgba(56, 189, 248, 0.4);
            }

            .btn-sm {
              padding: 9px 18px;
              font-size: 13px;
              border-radius: var(--radius-sm);
            }

            /* --------------------------------------------------------------------------
   6. NAVBAR & THEME TOGGLE
   4. NAVBAR
   -------------------------------------------------------------------------- */
            .navbar {
              .site-nav {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1000;
                padding: 20px 0;
                transition: padding var(--transition-normal), background var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
                padding: 18px 0;
                transition: background var(--t-mid), padding var(--t-mid), box-shadow var(--t-mid), border-color var(--t-mid);
                border-bottom: 1px solid transparent;
              }

              .navbar.scrolled {
                background: var(--bg-glass);

                .site-nav.scrolled {
                  background: rgba(250, 249, 255, 0.92);
                  backdrop-filter: blur(20px) saturate(180%);
                  -webkit-backdrop-filter: blur(20px) saturate(180%);
                  padding: 13px 0;
                  border-bottom: 1px solid var(--border-subtle);
                  box-shadow: var(--shadow-nav);
                  padding: 12px 0;
                  border-bottom: 1px solid var(--border);
                  box-shadow: 0 4px 24px rgba(124, 58, 237, 0.1);
                }

                .nav-inner {
                  .nav-container {
                    max-width: 1200px;
                    margin: 0 auto;
                    padding: 0 28px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                  }

                  .logo {
                    .nav-logo {
                      display: flex;
                      align-items: center;
                      gap: 0;
                      font-family: var(--font-display);
                      font-weight: 800;
                      font-size: 20px;
                      color: var(--text-primary);
                      font-size: 18px;
                      letter-spacing: 0.04em;
                      color: var(--text);
                    }

                    .logo-mark {
                      width: 34px;
                      height: 34px;
                      border-radius: var(--r-md);
                      background: var(--grad-main);
                      color: #fff;
                      display: flex;
                      align-items: center;
                      gap: 10px;
                      letter-spacing: -0.02em;
                      justify-content: center;
                      font-size: 16px;
                      font-weight: 800;
                      margin-right: 8px;
                      flex-shrink: 0;
                      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4);
                    }

                    .logo-text {
                      color: var(--text);
                    }

                    .logo-dot {
                      width: 10px;
                      height: 10px;
                      border-radius: 50%;
                      background: var(--grad-signature);
                      box-shadow: 0 0 16px rgba(56, 189, 248, 0.8);
                      animation: pulseGlow 2.5s infinite;
                    }

                    .logo-badge {
                      font-family: var(--font-mono);
                      font-size: 11px;
                      font-weight: 600;
                      color: var(--electric-blue);
                      background: var(--electric-blue-soft);
                      border: 1px solid rgba(56, 189, 248, 0.3);
                      padding: 2px 7px;
                      border-radius: var(--radius-pill);
                    }

                    @keyframes pulseGlow {

                      0%,
                      100% {
                        box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
                      }

                      50% {
                        box-shadow: 0 0 18px rgba(168, 85, 247, 0.9);
                      }
                    }

                    .nav-links {
                      display: flex;
                      gap: 32px;
                      gap: 34px;
                      align-items: center;
                    }

                    .nav-link {
                      .nl {
                        font-size: 14.5px;
                        color: var(--text-muted);
                        font-weight: 500;
                        color: var(--text-2);
                        position: relative;
                        padding: 6px 0;
                        transition: color var(--transition-fast);
                        padding: 4px 0;
                        transition: color var(--t-fast);
                      }

                      .nav-link::after {
                        .nl::after {
                          content: '';
                          position: absolute;
                          left: 0;
                          bottom: 0;
                          width: 0%;
                          height: 2px;
                          background: var(--grad-signature);
                          border-radius: var(--radius-pill);
                          transition: width var(--transition-normal);
                          left: 0;
                          bottom: -2px;
                          width: 0;
                          height: 2px;
                          background: var(--purple);
                          border-radius: var(--r-pill);
                          transition: width var(--t-mid);
                        }

                        .nl:hover,
                        .nl.active {
                          color: var(--purple);
                        }

                        .nl:hover::after,
                        .nl.active::after {
                          width: 100%;
                        }

                        .nav-link:hover,
                        .nav-link.active {
                          color: var(--text-primary);
                        }

                        .nav-right {
                          display: flex;
                          align-items: center;
                          gap: 14px;
                        }

                        .nav-link:hover::after,
                        .nav-link.active::after {
                          width: 100%;
                        }

                        .nav-actions {
                          display: flex;

                          .nav-cta-btn {
                            display: inline-flex;
                            align-items: center;
                            gap: 16px;
                          }

                          /* Theme Toggle Button */
                          .theme-toggle {
                            width: 42px;
                            height: 42px;
                            border-radius: var(--radius-md);
                            border: 1px solid var(--border-subtle);
                            background: var(--bg-card);
                            color: var(--text-primary);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 16px;
                            transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
                            backdrop-filter: blur(8px);
                          }

                          .theme-toggle:hover {
                            border-color: var(--electric-blue);
                            background: var(--electric-blue-soft);
                            color: var(--electric-blue);
                            transform: translateY(-2px) rotate(15deg);
                            box-shadow: 0 6px 18px -6px var(--electric-blue-glow);
                          }

                          .theme-toggle .fa-sun {
                            color: #f59e0b;
                          }

                          .theme-toggle .fa-moon {
                            color: var(--soft-purple);
                          }

                          .mobile-theme-btn {
                            width: 100% !important;
                            height: auto;
                            padding: 12px 18px;
                            border-radius: var(--radius-md);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            gap: 10px;
                            font-family: var(--font-mono);
                            font-size: 13px;
                            font-weight: 600;
                          }

                          .mobile-theme-btn:hover {
                            transform: none;
                          }

                          .nav-cta {
                            gap: 8px;
                            padding: 10px 22px;
                            border-radius: var(--radius-pill);
                            border: 1px solid var(--border-strong);
                            font-size: 13.5px;
                            background: var(--grad-main);
                            color: #fff;
                            font-size: 14px;
                            font-weight: 600;
                            color: var(--text-primary);
                            background: var(--bg-card);
                            backdrop-filter: blur(10px);
                            transition: all var(--transition-fast);
                            border-radius: var(--r-pill);
                            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.35);
                            transition: transform var(--t-fast), box-shadow var(--t-fast);
                          }

                          .nav-cta-btn i {
                            font-size: 12px;
                            transition: transform var(--t-fast);
                          }

                          .nav-cta-btn:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.5);
                            color: #fff;
                          }

                          .nav-cta-btn:hover i {
                            transform: translateX(3px);
                          }

                          .nav-cta:hover {
                            border-color: var(--electric-blue);
                            background: var(--electric-blue-soft);
                            color: var(--electric-blue);
                            transform: translateY(-2px);
                            box-shadow: 0 8px 22px -10px var(--electric-blue-glow);
                          }

                          .nav-toggle {
                            .hamburger {
                              display: none;
                              width: 42px;
                              height: 42px;
                              border-radius: var(--radius-md);
                              border: 1px solid var(--border-subtle);
                              flex-direction: column;
                              gap: 5px;
                              width: 40px;
                              height: 40px;
                              border-radius: var(--r-sm);
                              border: 1px solid var(--border-med);
                              align-items: center;
                              justify-content: center;
                              color: var(--text-primary);
                              font-size: 18px;
                              background: var(--bg-card);
                              backdrop-filter: blur(8px);
                              transition: border-color var(--transition-fast), color var(--transition-fast);
                              background: var(--surface);
                            }

                            .hamburger span {
                              width: 18px;
                              height: 2px;
                              background: var(--purple);
                              border-radius: var(--r-pill);
                              transition: all var(--t-fast);
                            }

                            .nav-toggle:hover {
                              border-color: var(--electric-blue);
                              color: var(--electric-blue);

                              /* Mobile Drawer */
                              .mobile-backdrop {
                                position: fixed;
                                inset: 0;
                                background: rgba(33, 27, 45, 0.55);
                                backdrop-filter: blur(6px);
                                z-index: 1050;
                                opacity: 0;
                                pointer-events: none;
                                transition: opacity var(--t-mid);
                              }

                              .mobile-backdrop.open {
                                opacity: 1;
                                pointer-events: auto;
                              }

                              /* Mobile Drawer */
                              .mobile-menu {
                                .mobile-nav {
                                  position: fixed;
                                  top: 0;
                                  right: -100%;
                                  width: min(84vw, 340px);
                                  top: 0;
                                  right: -100%;
                                  width: min(85vw, 340px);
                                  height: 100vh;
                                  background: var(--bg-surface);
                                  border-left: 1px solid var(--border-subtle);
                                  background: var(--surface);
                                  border-left: 1px solid var(--border);
                                  z-index: 1100;
                                  padding: 90px 28px 40px;
                                  transition: right 0.4s var(--ease);
                                  padding: 80px 28px 40px;
                                  display: flex;
                                  flex-direction: column;
                                  gap: 20px;
                                  box-shadow: -20px 0 60px -25px rgba(0, 0, 0, 0.6);
                                  gap: 18px;
                                  transition: right 0.42s var(--ease);
                                  overflow-y: auto;
                                  box-shadow: -10px 0 40px rgba(124, 58, 237, 0.15);
                                }

                                .mobile-nav.open {
                                  right: 0;
                                }

                                .mobile-menu.open {
                                  right: 0;

                                  .mobile-close {
                                    position: absolute;
                                    top: 20px;
                                    right: 20px;
                                    width: 38px;
                                    height: 38px;
                                    border-radius: var(--r-sm);
                                    border: 1px solid var(--border);
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    color: var(--text-2);
                                    font-size: 18px;
                                    transition: all var(--t-fast);
                                  }

                                  .mobile-close:hover {
                                    border-color: var(--purple);
                                    color: var(--purple);
                                  }

                                  .mobile-menu a {
                                    .mn-link {
                                      font-family: var(--font-display);
                                      font-size: 19px;
                                      font-size: 20px;
                                      font-weight: 600;
                                      color: var(--text-secondary);
                                      transition: color var(--transition-fast), padding-left var(--transition-fast);
                                      padding: 8px 0;
                                      border-bottom: 1px solid var(--border-subtle);
                                      color: var(--text-2);
                                      padding: 10px 0;
                                      border-bottom: 1px solid var(--border);
                                      transition: color var(--t-fast), padding-left var(--t-fast);
                                    }

                                    .mn-link:hover {
                                      color: var(--purple);
                                      padding-left: 8px;
                                    }

                                    .mobile-menu a:hover,
                                    .mobile-menu a.active {
                                      color: var(--electric-blue);
                                      padding-left: 6px;

                                      .mn-cta {
                                        margin-top: 12px;
                                        padding: 14px;
                                        background: var(--grad-main);
                                        color: #fff;
                                        border-radius: var(--r-md);
                                        font-weight: 600;
                                        font-size: 15px;
                                        text-align: center;
                                        box-shadow: var(--shadow-md);
                                      }

                                      .mobile-menu-actions {
                                        margin-top: 24px;
                                        display: flex;
                                        flex-direction: column;
                                        gap: 14px;
                                      }

                                      .menu-backdrop {
                                        position: fixed;
                                        inset: 0;
                                        background: rgba(7, 11, 20, 0.7);
                                        backdrop-filter: blur(6px);
                                        -webkit-backdrop-filter: blur(6px);
                                        z-index: 1050;
                                        opacity: 0;
                                        pointer-events: none;
                                        transition: opacity 0.35s var(--ease);
                                      }

                                      .menu-backdrop.open {
                                        opacity: 1;
                                        pointer-events: auto;
                                      }

                                      /* --------------------------------------------------------------------------
   7. HERO SECTION — VISUALLY STUNNING DEVELOPER SHOWCASE
   5. HERO
   -------------------------------------------------------------------------- */
                                      .hero {
                                        min-height: 100vh;
                                        display: flex;
                                        align-items: center;
                                        padding-top: 130px;
                                        padding-bottom: 80px;
                                        padding: 130px 0 80px;
                                        position: relative;
                                        overflow: hidden;
                                        background: var(--bg);
                                      }

                                      /* Blobs */
                                      .hero-blob {
                                        position: absolute;
                                        border-radius: 50%;
                                        filter: blur(90px);
                                        pointer-events: none;
                                      }

                                      .hero-blob-1 {
                                        width: 700px;
                                        height: 700px;
                                        top: -220px;
                                        right: -180px;
                                        background: radial-gradient(circle, rgba(124, 58, 237, 0.18) 0%, transparent 70%);
                                        animation: blobFloat 18s ease-in-out infinite alternate;
                                      }

                                      .hero-blob-2 {
                                        width: 560px;
                                        height: 560px;
                                        bottom: -140px;
                                        left: -160px;
                                        background: radial-gradient(circle, rgba(167, 139, 250, 0.14) 0%, transparent 70%);
                                        animation: blobFloat 24s ease-in-out infinite alternate-reverse;
                                      }

                                      .hero-blob-3 {
                                        width: 360px;
                                        height: 360px;
                                        top: 40%;
                                        left: 40%;
                                        background: radial-gradient(circle, rgba(91, 33, 182, 0.1) 0%, transparent 70%);
                                        animation: blobFloat 20s ease-in-out infinite alternate;
                                      }

                                      @keyframes blobFloat {
                                        0% {
                                          transform: translate(0, 0) scale(1);
                                        }

                                        50% {
                                          transform: translate(40px, 30px) scale(1.08);
                                        }

                                        100% {
                                          transform: translate(-30px, 50px) scale(0.96);
                                        }
                                      }

                                      /* Abstract decorative shapes */
                                      .hero-shape {
                                        position: absolute;
                                        pointer-events: none;
                                      }

                                      .hero-shape-ring {
                                        width: 300px;
                                        height: 300px;
                                        border: 2px solid rgba(124, 58, 237, 0.12);
                                        border-radius: 50%;
                                        top: 10%;
                                        right: 4%;
                                        animation: spinSlow 40s linear infinite;
                                      }

                                      .hero-shape-ring::after {
                                        content: '';
                                        position: absolute;
                                        width: 180px;
                                        height: 180px;
                                        border: 1px dashed rgba(124, 58, 237, 0.18);
                                        border-radius: 50%;
                                        top: 50%;
                                        left: 50%;
                                        transform: translate(-50%, -50%);
                                      }

                                      @keyframes spinSlow {
                                        to {
                                          transform: rotate(360deg);
                                        }
                                      }

                                      .hero-shape-dot-grid {
                                        width: 160px;
                                        height: 160px;
                                        top: 60%;
                                        left: 2%;
                                        background-image: radial-gradient(circle, rgba(124, 58, 237, 0.25) 1.5px, transparent 1.5px);
                                        background-size: 20px 20px;
                                        opacity: 0.5;
                                      }

                                      .hero-shape-cross {
                                        width: 24px;
                                        height: 24px;
                                        bottom: 18%;
                                        right: 8%;
                                        background:
                                          linear-gradient(var(--purple), var(--purple)) center/3px 100% no-repeat,
                                          linear-gradient(var(--purple), var(--purple)) center/100% 3px no-repeat;
                                        opacity: 0.35;
                                        border-radius: 2px;
                                        animation: crossPulse 3s ease-in-out infinite;
                                      }

                                      @keyframes crossPulse {

                                        0%,
                                        100% {
                                          opacity: 0.35;
                                          transform: scale(1);
                                        }

                                        50% {
                                          opacity: 0.65;
                                          transform: scale(1.3);
                                        }
                                      }

                                      /* Inner layout */
                                      .hero-inner {
                                        max-width: 1200px;
                                        margin: 0 auto;
                                        padding: 0 28px;
                                        display: grid;
                                        grid-template-columns: 1.15fr 0.85fr;
                                        gap: 50px;
                                        grid-template-columns: 1.1fr 0.9fr;
                                        gap: 60px;
                                        align-items: center;
                                      }

                                      .hero-content {
                                        position: relative;
                                        z-index: 2;
                                        width: 100%;
                                      }

                                      .hero-eyebrow {
                                        font-family: var(--font-mono);
                                        font-size: 13px;
                                        color: var(--electric-blue);
                                        background: var(--electric-blue-soft);
                                        border: 1px solid rgba(56, 189, 248, 0.3);

                                        /* Hero content */
                                        .hero-content {}

                                        [data-reveal="left"] {
                                          opacity: 0;
                                          transform: translateX(-50px);
                                          animation: heroSlideIn 1s var(--ease) 0.1s forwards;
                                        }

                                        [data-reveal="right"] {
                                          opacity: 0;
                                          transform: translateX(50px);
                                          animation: heroSlideIn 1s var(--ease) 0.3s forwards;
                                        }

                                        @keyframes heroSlideIn {
                                          to {
                                            opacity: 1;
                                            transform: translateX(0);
                                          }
                                        }

                                        .hero-tag {
                                          display: inline-flex;
                                          align-items: center;
                                          gap: 10px;
                                          font-family: var(--font-mono);
                                          font-size: 13px;
                                          color: var(--purple);
                                          background: var(--purple-faint);
                                          border: 1px solid rgba(124, 58, 237, 0.25);
                                          padding: 7px 16px;
                                          border-radius: var(--radius-pill);
                                          margin-bottom: 24px;
                                          opacity: 0;
                                          animation: fadeUp 0.8s var(--ease) forwards;
                                          border-radius: var(--r-pill);
                                          margin-bottom: 26px;
                                        }

                                        .hero-eyebrow .pulse {
                                          width: 8px;
                                          height: 8px;

                                          .tag-dot {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 50%;
                                            background: var(--emerald-accent);
                                            box-shadow: 0 0 0 rgba(16, 185, 129, 0.6);
                                            animation: statusPulse 2s infinite;
                                            background: #10b981;
                                            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5);
                                            animation: greenPulse 2.4s infinite;
                                          }

                                          @keyframes statusPulse {
                                            0% {
                                              box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
                                            }

                                            70% {
                                              box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
                                            }

                                            100% {
                                              box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
                                            }

                                            @keyframes greenPulse {
                                              0% {
                                                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
                                              }

                                              70% {
                                                box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
                                              }

                                              100% {
                                                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
                                              }
                                            }

                                            .hero h1 {
                                              .hero-heading {
                                                font-family: var(--font-display);
                                                font-size: clamp(42px, 5.8vw, 68px);
                                                font-size: clamp(44px, 6.5vw, 76px);
                                                font-weight: 800;
                                                line-height: 1.08;
                                                color: var(--text);
                                                line-height: 1.06;
                                                letter-spacing: -0.03em;
                                                color: var(--text-primary);
                                                margin-bottom: 18px;
                                                opacity: 0;
                                                animation: fadeUp 0.8s var(--ease) 0.1s forwards;
                                              }

                                              .hero-name {
                                                display: block;
                                                background: var(--grad-main);
                                                -webkit-background-clip: text;
                                                background-clip: text;
                                                color: transparent;
                                              }

                                              .hero-sub {

                                                /* Animated role cycle */
                                                .hero-roles {
                                                  font-family: var(--font-display);
                                                  font-size: clamp(20px, 2.4vw, 26px);
                                                  font-size: clamp(18px, 2.2vw, 24px);
                                                  font-weight: 600;
                                                  color: var(--text-primary);
                                                  margin-bottom: 20px;
                                                  color: var(--text-2);
                                                  margin-bottom: 22px;
                                                  display: flex;
                                                  align-items: center;
                                                  gap: 6px;
                                                }

                                                .role-static {
                                                  color: var(--text-2);
                                                }

                                                .role-cycle {
                                                  position: relative;
                                                  display: inline-block;
                                                  min-width: 220px;
                                                  height: 1.4em;
                                                  overflow: hidden;
                                                }

                                                .rc {
                                                  position: absolute;
                                                  left: 0;
                                                  top: 0;
                                                  color: var(--purple);
                                                  opacity: 0;
                                                  animation: fadeUp 0.8s var(--ease) 0.22s forwards;
                                                  transform: translateY(100%);
                                                  transition: opacity 0.5s, transform 0.5s var(--ease);
                                                  white-space: nowrap;
                                                }

                                                .hero-sub .role-highlight {
                                                  color: var(--electric-blue);

                                                  .rc.active {
                                                    opacity: 1;
                                                    transform: translateY(0);
                                                  }

                                                  .hero-sub .role-admin {
                                                    color: var(--soft-purple);

                                                    .rc.exit {
                                                      opacity: 0;
                                                      transform: translateY(-100%);
                                                    }

                                                    .hero p.intro {
                                                      max-width: 560px;
                                                      color: var(--text-secondary);

                                                      .hero-desc {
                                                        max-width: 510px;
                                                        color: var(--text-2);
                                                        font-size: 16.5px;
                                                        line-height: 1.7;
                                                        margin-bottom: 36px;
                                                        opacity: 0;
                                                        animation: fadeUp 0.8s var(--ease) 0.34s forwards;
                                                      }

                                                      .hero-desc strong {
                                                        color: var(--purple);
                                                        font-weight: 600;
                                                      }

                                                      .hero-actions {
                                                        .hero-ctas {
                                                          display: flex;
                                                          gap: 16px;
                                                          flex-wrap: wrap;
                                                          margin-bottom: 48px;
                                                          opacity: 0;
                                                          animation: fadeUp 0.8s var(--ease) 0.46s forwards;
                                                          margin-bottom: 44px;
                                                        }

                                                        .cta-primary {
                                                          display: inline-flex;
                                                          align-items: center;
                                                          gap: 10px;
                                                          padding: 15px 30px;
                                                          background: var(--grad-main);
                                                          color: #fff;
                                                          font-size: 15px;
                                                          font-weight: 700;
                                                          border-radius: var(--r-md);
                                                          box-shadow: 0 8px 28px rgba(124, 58, 237, 0.42);
                                                          position: relative;
                                                          overflow: hidden;
                                                          transition: transform var(--t-fast), box-shadow var(--t-fast);
                                                        }

                                                        .cta-primary::after {
                                                          content: '';
                                                          position: absolute;
                                                          top: 0;
                                                          left: -100%;
                                                          width: 60%;
                                                          height: 100%;
                                                          background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
                                                          transform: skewX(-20deg);
                                                          transition: left 0.6s var(--ease);
                                                        }

                                                        .cta-primary:hover {
                                                          transform: translateY(-3px);
                                                          box-shadow: 0 14px 36px rgba(124, 58, 237, 0.55);
                                                          color: #fff;
                                                        }

                                                        .cta-primary:hover::after {
                                                          left: 150%;
                                                        }

                                                        .cta-primary i {
                                                          transition: transform var(--t-fast);
                                                        }

                                                        .cta-primary:hover i {
                                                          transform: translateX(4px);
                                                        }

                                                        .cta-secondary {
                                                          display: inline-flex;
                                                          align-items: center;
                                                          gap: 10px;
                                                          padding: 14px 28px;
                                                          border: 2px solid var(--border-med);
                                                          color: var(--purple);
                                                          font-size: 15px;
                                                          font-weight: 600;
                                                          border-radius: var(--r-md);
                                                          background: var(--purple-faint);
                                                          transition: all var(--t-fast);
                                                        }

                                                        .cta-secondary:hover {
                                                          background: var(--purple);
                                                          color: #fff;
                                                          border-color: var(--purple);
                                                          transform: translateY(-3px);
                                                          box-shadow: 0 10px 28px rgba(124, 58, 237, 0.35);
                                                        }

                                                        .hero-stats {
                                                          display: flex;
                                                          gap: 40px;
                                                          flex-wrap: wrap;
                                                          padding-top: 32px;
                                                          border-top: 1px solid var(--border-subtle);
                                                          opacity: 0;
                                                          animation: fadeUp 0.8s var(--ease) 0.58s forwards;
                                                          align-items: center;
                                                          gap: 28px;
                                                          padding-top: 30px;
                                                          border-top: 1px solid var(--border);
                                                        }

                                                        .stat-item strong {
                                                          .hs-item strong {
                                                            display: block;
                                                            font-family: var(--font-display);
                                                            font-size: 28px;
                                                            font-size: 24px;
                                                            font-weight: 800;
                                                            color: var(--text-primary);
                                                            color: var(--purple);
                                                            letter-spacing: -0.02em;
                                                          }

                                                          .stat-item span {
                                                            .hs-item span {
                                                              font-family: var(--font-mono);
                                                              font-size: 12px;
                                                              font-weight: 500;
                                                              color: var(--text-muted);
                                                              font-size: 11.5px;
                                                              color: var(--text-3);
                                                              text-transform: uppercase;
                                                              letter-spacing: 0.06em;
                                                              text-transform: uppercase;
                                                            }

                                                            .hs-divider {
                                                              width: 1px;
                                                              height: 38px;
                                                              background: var(--border);
                                                            }

                                                            /* Hero Visual / Developer Card Showcase */
                                                            /* Hero Visual */
                                                            .hero-visual {
                                                              position: relative;
                                                              min-height: 480px;
                                                              display: flex;
                                                              align-items: center;
                                                              justify-content: center;
                                                              perspective: 1000px;
                                                              height: 500px;
                                                            }

                                                            .hero-visual-card {
                                                              width: 100%;
                                                              max-width: 440px;
                                                              background: var(--bg-card);
                                                              border: 1px solid var(--border-card);
                                                              border-radius: var(--radius-lg);
                                                              backdrop-filter: blur(24px) saturate(180%);
                                                              -webkit-backdrop-filter: blur(24px) saturate(180%);
                                                              box-shadow: var(--shadow-card-hover);
                                                              position: relative;
                                                              z-index: 2;
                                                              overflow: hidden;
                                                              transition: transform var(--transition-normal), border-color var(--transition-normal);

                                                              /* Orbit rings */
                                                              .hv-orbit {
                                                                position: absolute;
                                                                width: 420px;
                                                                height: 420px;
                                                                top: 50%;
                                                                left: 50%;
                                                                transform: translate(-50%, -50%);
                                                              }

                                                              .hero-visual-card:hover {
                                                                transform: translateY(-5px);
                                                                border-color: var(--electric-blue);

                                                                .orbit-ring {
                                                                  position: absolute;
                                                                  border-radius: 50%;
                                                                  border: 1px dashed rgba(124, 58, 237, 0.2);
                                                                  top: 50%;
                                                                  left: 50%;
                                                                  transform: translate(-50%, -50%);
                                                                  animation: orbitSpin 30s linear infinite;
                                                                }

                                                                .orbit-ring-1 {
                                                                  width: 100%;
                                                                  height: 100%;
                                                                  animation-duration: 35s;
                                                                }

                                                                .orbit-ring-2 {
                                                                  width: 70%;
                                                                  height: 70%;
                                                                  animation-direction: reverse;
                                                                  animation-duration: 25s;
                                                                }

                                                                @keyframes orbitSpin {
                                                                  to {
                                                                    transform: translate(-50%, -50%) rotate(360deg);
                                                                  }
                                                                }

                                                                .card-window-header {

                                                                  /* Orbit badges */
                                                                  .orbit-badge {
                                                                    position: absolute;
                                                                    display: flex;
                                                                    align-items: center;
                                                                    justify-content: space-between;
                                                                    padding: 14px 18px;
                                                                    background: rgba(15, 23, 42, 0.4);
                                                                    border-bottom: 1px solid var(--border-subtle);
                                                                    gap: 7px;
                                                                    background: var(--surface);
                                                                    border: 1px solid var(--border-med);
                                                                    border-radius: var(--r-md);
                                                                    padding: 8px 14px;
                                                                    font-family: var(--font-mono);
                                                                    font-size: 12px;
                                                                    font-weight: 600;
                                                                    color: var(--purple);
                                                                    box-shadow: var(--shadow-md);
                                                                    white-space: nowrap;
                                                                    animation: floatBadge 5s ease-in-out infinite;
                                                                  }

                                                                  .window-dots {
                                                                    display: flex;
                                                                    gap: 6px;

                                                                    .orbit-badge i {
                                                                      font-size: 14px;
                                                                    }

                                                                    .ob-1 {
                                                                      top: -10px;
                                                                      left: 50%;
                                                                      transform: translateX(-50%);
                                                                      animation-delay: 0s;
                                                                    }

                                                                    .ob-2 {
                                                                      right: -30px;
                                                                      top: 50%;
                                                                      transform: translateY(-50%);
                                                                      animation-delay: 0.8s;
                                                                    }

                                                                    .ob-3 {
                                                                      bottom: -10px;
                                                                      left: 50%;
                                                                      transform: translateX(-50%);
                                                                      animation-delay: 1.6s;
                                                                    }

                                                                    .ob-4 {
                                                                      left: -40px;
                                                                      top: 50%;
                                                                      transform: translateY(-50%);
                                                                      animation-delay: 2.4s;
                                                                    }

                                                                    @keyframes floatBadge {

                                                                      0%,
                                                                      100% {
                                                                        transform: translateX(-50%) translateY(0);
                                                                      }

                                                                      50% {
                                                                        transform: translateX(-50%) translateY(-8px);
                                                                      }
                                                                    }

                                                                    .window-dot {
                                                                      width: 10px;
                                                                      height: 10px;
                                                                      border-radius: 50%;

                                                                      .ob-2,
                                                                      .ob-4 {
                                                                        animation-name: floatBadgeY;
                                                                      }

                                                                      .window-dot.red {
                                                                        background: #ef4444;
                                                                      }

                                                                      .window-dot.yellow {
                                                                        background: #f59e0b;
                                                                      }

                                                                      .window-dot.green {
                                                                        background: #10b981;
                                                                      }

                                                                      .window-title {
                                                                        font-family: var(--font-mono);
                                                                        font-size: 11.5px;
                                                                        color: var(--text-muted);

                                                                        @keyframes floatBadgeY {

                                                                          0%,
                                                                          100% {
                                                                            transform: translateY(-50%);
                                                                          }

                                                                          50% {
                                                                            transform: translateY(calc(-50% - 8px));
                                                                          }
                                                                        }

                                                                        .card-dev-profile {
                                                                          padding: 24px 22px 18px;
                                                                          display: flex;
                                                                          align-items: center;
                                                                          gap: 16px;
                                                                        }

                                                                        .dev-avatar-wrap {

                                                                          /* Profile frame */
                                                                          .hv-frame {
                                                                            position: relative;
                                                                            width: 64px;
                                                                            height: 64px;
                                                                            border-radius: 50%;
                                                                            padding: 3px;
                                                                            background: var(--grad-signature);
                                                                            flex-shrink: 0;
                                                                            z-index: 2;
                                                                            width: 240px;
                                                                            height: 240px;
                                                                            border-radius: 40px;
                                                                            background: var(--grad-main);
                                                                            padding: 4px;
                                                                            box-shadow: 0 20px 60px rgba(124, 58, 237, 0.4), 0 0 0 8px rgba(124, 58, 237, 0.1);
                                                                          }

                                                                          .dev-avatar-wrap .avatar-inner {
                                                                            .hv-avatar {
                                                                              width: 100%;
                                                                              height: 100%;
                                                                              border-radius: 50%;
                                                                              background: var(--bg-surface);
                                                                              border-radius: 37px;
                                                                              background: var(--purple-pale);
                                                                              display: flex;
                                                                              align-items: center;
                                                                              justify-content: center;
                                                                              color: var(--electric-blue);
                                                                              font-size: 26px;
                                                                              font-size: 90px;
                                                                              color: var(--purple);
                                                                            }

                                                                            .avatar-online {

                                                                              /* Corner accents */
                                                                              .frame-corner {
                                                                                position: absolute;
                                                                                bottom: 2px;
                                                                                right: 2px;
                                                                                width: 14px;
                                                                                height: 14px;
                                                                                border-radius: 50%;
                                                                                background: var(--emerald-accent);
                                                                                border: 2px solid var(--bg-primary);
                                                                                width: 22px;
                                                                                height: 22px;
                                                                                border-color: var(--purple-light);
                                                                                border-style: solid;
                                                                                border-radius: 4px;
                                                                              }

                                                                              .fc-tl {
                                                                                top: -8px;
                                                                                left: -8px;
                                                                                border-width: 3px 0 0 3px;
                                                                              }

                                                                              .fc-tr {
                                                                                top: -8px;
                                                                                right: -8px;
                                                                                border-width: 3px 3px 0 0;
                                                                              }

                                                                              .fc-bl {
                                                                                bottom: -8px;
                                                                                left: -8px;
                                                                                border-width: 0 0 3px 3px;
                                                                              }

                                                                              .fc-br {
                                                                                bottom: -8px;
                                                                                right: -8px;
                                                                                border-width: 0 3px 3px 0;
                                                                              }

                                                                              .dev-info h3 {
                                                                                font-family: var(--font-display);
                                                                                font-size: 19px;
                                                                                font-weight: 700;
                                                                                color: var(--text-primary);
                                                                              }

                                                                              .dev-info p {
                                                                                font-family: var(--font-mono);

                                                                                /* Floating tech chips */
                                                                                .tech-chip {
                                                                                  position: absolute;
                                                                                  display: flex;
                                                                                  align-items: center;
                                                                                  gap: 7px;
                                                                                  background: var(--surface);
                                                                                  border: 1px solid var(--border);
                                                                                  border-radius: var(--r-md);
                                                                                  padding: 8px 14px;
                                                                                  font-size: 12.5px;
                                                                                  color: var(--electric-blue);
                                                                                  font-weight: 600;
                                                                                  color: var(--text);
                                                                                  box-shadow: var(--shadow-sm);
                                                                                  z-index: 3;
                                                                                  animation: floatChip 6s ease-in-out infinite;
                                                                                }

                                                                                .dev-code-snippet {
                                                                                  margin: 0 18px 20px;
                                                                                  padding: 16px;
                                                                                  background: rgba(7, 11, 20, 0.75);
                                                                                  border-radius: var(--radius-md);
                                                                                  border: 1px solid var(--border-subtle);
                                                                                  font-family: var(--font-mono);
                                                                                  font-size: 12px;
                                                                                  line-height: 1.6;
                                                                                  color: #e2e8f0;

                                                                                  .tech-chip i {
                                                                                    color: var(--purple);
                                                                                  }

                                                                                  .tc-1 {
                                                                                    top: 8%;
                                                                                    right: 2%;
                                                                                    animation-delay: 0s;
                                                                                  }

                                                                                  .tc-2 {
                                                                                    bottom: 18%;
                                                                                    right: -4%;
                                                                                    animation-delay: 1.2s;
                                                                                  }

                                                                                  .tc-3 {
                                                                                    bottom: 8%;
                                                                                    left: 0%;
                                                                                    animation-delay: 2.4s;
                                                                                  }

                                                                                  @keyframes floatChip {

                                                                                    0%,
                                                                                    100% {
                                                                                      transform: translateY(0);
                                                                                    }

                                                                                    50% {
                                                                                      transform: translateY(-10px);
                                                                                    }
                                                                                  }

                                                                                  .dev-code-snippet .code-keyword {
                                                                                    color: #c084fc;
                                                                                    font-weight: 600;
                                                                                  }

                                                                                  .dev-code-snippet .code-type {
                                                                                    color: #38bdf8;
                                                                                  }

                                                                                  .dev-code-snippet .code-string {
                                                                                    color: #34d399;
                                                                                  }

                                                                                  .dev-code-snippet .code-comment {
                                                                                    color: #64748b;
                                                                                    font-style: italic;
                                                                                  }

                                                                                  .orbit-svg-underlay {

                                                                                    /* Scroll hint */
                                                                                    .scroll-hint {
                                                                                      position: absolute;
                                                                                      width: 480px;
                                                                                      height: 480px;
                                                                                      top: 50%;
                                                                                      bottom: 30px;
                                                                                      left: 50%;
                                                                                      transform: translate(-50%, -50%);
                                                                                      pointer-events: none;
                                                                                      z-index: 1;
                                                                                    }

                                                                                    /* Floating Node Badges */
                                                                                    .node-card {
                                                                                      position: absolute;
                                                                                      background: var(--bg-card);
                                                                                      border: 1px solid var(--border-card);
                                                                                      backdrop-filter: blur(14px);
                                                                                      -webkit-backdrop-filter: blur(14px);
                                                                                      border-radius: var(--radius-md);
                                                                                      padding: 10px 16px;
                                                                                      font-family: var(--font-mono);
                                                                                      font-size: 12px;
                                                                                      font-weight: 500;
                                                                                      color: var(--text-primary);
                                                                                      transform: translateX(-50%);
                                                                                      display: flex;
                                                                                      flex-direction: column;
                                                                                      align-items: center;
                                                                                      gap: 10px;
                                                                                      box-shadow: var(--shadow-card);
                                                                                      z-index: 3;
                                                                                      animation: floaty 5.5s ease-in-out infinite;
                                                                                      transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
                                                                                      gap: 8px;
                                                                                      font-family: var(--font-mono);
                                                                                      font-size: 11px;
                                                                                      letter-spacing: 0.1em;
                                                                                      text-transform: uppercase;
                                                                                      color: var(--text-3);
                                                                                      opacity: 0.7;
                                                                                    }

                                                                                    .sh-mouse {
                                                                                      width: 24px;
                                                                                      height: 38px;
                                                                                      border: 2px solid rgba(124, 58, 237, 0.3);
                                                                                      border-radius: 14px;
                                                                                      display: flex;
                                                                                      align-items: flex-start;
                                                                                      justify-content: center;
                                                                                      padding-top: 6px;
                                                                                    }

                                                                                    .sh-wheel {
                                                                                      width: 4px;
                                                                                      height: 8px;
                                                                                      background: var(--purple);
                                                                                      border-radius: var(--r-pill);
                                                                                      animation: wheelScroll 2s ease-in-out infinite;
                                                                                    }

                                                                                    @keyframes wheelScroll {

                                                                                      0%,
                                                                                      100% {
                                                                                        opacity: 1;
                                                                                        transform: translateY(0);
                                                                                      }

                                                                                      50% {
                                                                                        opacity: 0;
                                                                                        transform: translateY(10px);
                                                                                      }
                                                                                    }

                                                                                    .node-card i {
                                                                                      color: var(--electric-blue);
                                                                                      font-size: 14px;

                                                                                      /* --------------------------------------------------------------------------
   6. ABOUT
   -------------------------------------------------------------------------- */
                                                                                      .section-about {
                                                                                        padding: 110px 0;
                                                                                        background: var(--bg);
                                                                                      }

                                                                                      .node-card:hover {
                                                                                        border-color: var(--electric-blue);
                                                                                        box-shadow: var(--shadow-card-hover);
                                                                                        transform: translateY(-4px) scale(1.03);

                                                                                        .about-layout {
                                                                                          display: grid;
                                                                                          grid-template-columns: 1.1fr 0.9fr;
                                                                                          gap: 60px;
                                                                                          align-items: start;
                                                                                        }

                                                                                        .node-card.n1 {
                                                                                          top: 2%;
                                                                                          left: -6%;
                                                                                          animation-delay: 0s;
                                                                                        }

                                                                                        .node-card.n2 {
                                                                                          bottom: 12%;
                                                                                          left: -8%;
                                                                                          animation-delay: 0.8s;
                                                                                        }

                                                                                        .node-card.n3 {
                                                                                          top: 18%;
                                                                                          right: -8%;
                                                                                          animation-delay: 1.5s;
                                                                                        }

                                                                                        .node-card.n4 {
                                                                                          bottom: 4%;
                                                                                          right: 2%;
                                                                                          animation-delay: 2.2s;
                                                                                        }

                                                                                        .about-intro .section-eyebrow {
                                                                                          margin-bottom: 20px;
                                                                                        }

                                                                                        @keyframes floaty {

                                                                                          0%,
                                                                                          100% {
                                                                                            transform: translateY(0);
                                                                                          }

                                                                                          50% {
                                                                                            transform: translateY(-10px);
                                                                                          }

                                                                                          .about-body {
                                                                                            font-size: 16px;
                                                                                            color: var(--text-2);
                                                                                            line-height: 1.75;
                                                                                            margin-bottom: 18px;
                                                                                          }

                                                                                          .about-body strong {
                                                                                            color: var(--purple);
                                                                                            font-weight: 600;
                                                                                          }

                                                                                          @keyframes fadeUp {
                                                                                            from {
                                                                                              opacity: 0;
                                                                                              transform: translateY(20px);
                                                                                            }

                                                                                            to {
                                                                                              opacity: 1;
                                                                                              transform: translateY(0);
                                                                                            }

                                                                                            .about-chips {
                                                                                              display: flex;
                                                                                              flex-wrap: wrap;
                                                                                              gap: 10px;
                                                                                              margin-top: 28px;
                                                                                            }

                                                                                            /* --------------------------------------------------------------------------
   8. ABOUT ME SECTION
   -------------------------------------------------------------------------- */
                                                                                            .about-grid {
                                                                                              display: grid;
                                                                                              grid-template-columns: 0.85fr 1.15fr;
                                                                                              gap: 48px;
                                                                                              align-items: start;

                                                                                              .achip {
                                                                                                display: inline-flex;
                                                                                                align-items: center;
                                                                                                gap: 8px;
                                                                                                font-family: var(--font-mono);
                                                                                                font-size: 12.5px;
                                                                                                font-weight: 600;
                                                                                                color: var(--purple);
                                                                                                background: var(--purple-faint);
                                                                                                border: 1px solid var(--border);
                                                                                                padding: 8px 14px;
                                                                                                border-radius: var(--r-pill);
                                                                                                transition: all var(--t-fast);
                                                                                              }

                                                                                              .achip:hover {
                                                                                                background: var(--purple);
                                                                                                color: #fff;
                                                                                                transform: translateY(-2px);
                                                                                                box-shadow: var(--shadow-sm);
                                                                                              }

                                                                                              /* About card */
                                                                                              .about-card {
                                                                                                border: 1px solid var(--border-card);
                                                                                                border-radius: var(--radius-lg);
                                                                                                background: var(--bg-card);
                                                                                                background: var(--surface);
                                                                                                border: 1px solid var(--border);
                                                                                                border-radius: var(--r-xl);
                                                                                                padding: 36px;
                                                                                                box-shadow: var(--shadow-card);
                                                                                                position: relative;
                                                                                                overflow: hidden;
                                                                                                box-shadow: var(--shadow-card);
                                                                                                backdrop-filter: blur(14px);
                                                                                              }

                                                                                              .about-card::before {
                                                                                                content: '';
                                                                                                position: absolute;
                                                                                                width: 200px;
                                                                                                height: 200px;
                                                                                                background: var(--grad-signature);
                                                                                                top: -60px;
                                                                                                right: -60px;
                                                                                                width: 180px;
                                                                                                height: 180px;
                                                                                                background: var(--grad-main);
                                                                                                filter: blur(80px);
                                                                                                opacity: 0.18;
                                                                                                top: -40px;
                                                                                                left: -40px;
                                                                                                opacity: 0.15;
                                                                                                pointer-events: none;
                                                                                              }

                                                                                              .about-card h3 {
                                                                                                .ac-header {
                                                                                                  display: flex;
                                                                                                  align-items: center;
                                                                                                  gap: 16px;
                                                                                                  margin-bottom: 28px;
                                                                                                  padding-bottom: 22px;
                                                                                                  border-bottom: 1px solid var(--border);
                                                                                                }

                                                                                                .ac-avatar {
                                                                                                  width: 60px;
                                                                                                  height: 60px;
                                                                                                  border-radius: var(--r-md);
                                                                                                  background: var(--grad-main);
                                                                                                  display: flex;
                                                                                                  align-items: center;
                                                                                                  justify-content: center;
                                                                                                  color: #fff;
                                                                                                  font-size: 26px;
                                                                                                  flex-shrink: 0;
                                                                                                  box-shadow: 0 6px 18px rgba(124, 58, 237, 0.35);
                                                                                                }

                                                                                                .ac-name {
                                                                                                  font-family: var(--font-display);
                                                                                                  font-size: 20px;
                                                                                                  font-weight: 700;
                                                                                                  color: var(--text-primary);
                                                                                                  margin-bottom: 22px;
                                                                                                  position: relative;
                                                                                                  color: var(--text);
                                                                                                }

                                                                                                .id-row {
                                                                                                  .ac-role {
                                                                                                    font-size: 13px;
                                                                                                    color: var(--purple);
                                                                                                    font-weight: 500;
                                                                                                    margin-top: 2px;
                                                                                                  }

                                                                                                  .ac-rows {
                                                                                                    display: flex;
                                                                                                    flex-direction: column;
                                                                                                    gap: 0;
                                                                                                  }

                                                                                                  .ac-row {
                                                                                                    display: flex;
                                                                                                    justify-content: space-between;
                                                                                                    align-items: center;
                                                                                                    padding: 13px 0;
                                                                                                    border-bottom: 1px solid var(--border-subtle);
                                                                                                    font-size: 14.5px;
                                                                                                    position: relative;
                                                                                                    padding: 12px 0;
                                                                                                    border-bottom: 1px solid var(--border);
                                                                                                    font-size: 14px;
                                                                                                  }

                                                                                                  .id-row:last-child {
                                                                                                    border-bottom: none;
                                                                                                  }

                                                                                                  .id-row span:first-child {
                                                                                                    color: var(--text-muted);
                                                                                                    font-family: var(--font-mono);
                                                                                                    font-size: 12px;
                                                                                                    letter-spacing: 0.05em;
                                                                                                  }

                                                                                                  .id-row span:last-child {
                                                                                                    color: var(--text-primary);
                                                                                                    font-weight: 600;
                                                                                                    text-align: right;
                                                                                                  }

                                                                                                  .about-content p {
                                                                                                    color: var(--text-secondary);
                                                                                                    font-size: 16px;
                                                                                                    line-height: 1.75;
                                                                                                    margin-bottom: 20px;
                                                                                                  }

                                                                                                  .about-content strong {
                                                                                                    color: var(--text-primary);
                                                                                                    font-weight: 600;
                                                                                                  }

                                                                                                  .focus-pills {
                                                                                                    margin-top: 32px;

                                                                                                    .ac-row:last-child {
                                                                                                      border-bottom: none;
                                                                                                    }

                                                                                                    .acr-label {
                                                                                                      font-family: var(--font-mono);
                                                                                                      font-size: 11px;
                                                                                                      color: var(--text-3);
                                                                                                      text-transform: uppercase;
                                                                                                      letter-spacing: 0.08em;
                                                                                                    }

                                                                                                    .acr-val {
                                                                                                      font-weight: 600;
                                                                                                      color: var(--text);
                                                                                                      text-align: right;
                                                                                                    }

                                                                                                    .acr-val a {
                                                                                                      color: var(--purple);
                                                                                                    }

                                                                                                    .acr-val a:hover {
                                                                                                      text-decoration: underline;
                                                                                                    }

                                                                                                    .acr-green {
                                                                                                      display: flex;
                                                                                                      align-items: center;
                                                                                                      gap: 6px;
                                                                                                      color: #059669 !important;
                                                                                                    }

                                                                                                    .green-dot {
                                                                                                      width: 7px;
                                                                                                      height: 7px;
                                                                                                      border-radius: 50%;
                                                                                                      background: #10b981;
                                                                                                      flex-shrink: 0;
                                                                                                    }

                                                                                                    .ac-socials {
                                                                                                      display: flex;
                                                                                                      flex-wrap: wrap;
                                                                                                      gap: 10px;
                                                                                                      gap: 12px;
                                                                                                      margin-top: 24px;
                                                                                                      padding-top: 22px;
                                                                                                      border-top: 1px solid var(--border);
                                                                                                    }

                                                                                                    .focus-chip {
                                                                                                      font-family: var(--font-mono);
                                                                                                      font-size: 12.5px;
                                                                                                      font-weight: 500;
                                                                                                      padding: 8px 16px;
                                                                                                      border-radius: var(--radius-pill);
                                                                                                      border: 1px solid var(--border-subtle);
                                                                                                      color: var(--text-primary);
                                                                                                      background: var(--bg-card);
                                                                                                      transition: all var(--transition-fast);
                                                                                                      display: inline-flex;
                                                                                                      align-items: center;
                                                                                                      gap: 8px;

                                                                                                      .ac-socials a {
                                                                                                        width: 40px;
                                                                                                        height: 40px;
                                                                                                        border-radius: var(--r-md);
                                                                                                        border: 1px solid var(--border-med);
                                                                                                        background: var(--purple-faint);
                                                                                                        display: flex;
                                                                                                        align-items: center;
                                                                                                        justify-content: center;
                                                                                                        color: var(--purple);
                                                                                                        font-size: 17px;
                                                                                                        transition: all var(--t-fast);
                                                                                                      }

                                                                                                      .focus-chip:hover {
                                                                                                        border-color: var(--electric-blue);
                                                                                                        color: var(--electric-blue);
                                                                                                        background: var(--electric-blue-soft);
                                                                                                        transform: translateY(-2px);
                                                                                                        box-shadow: 0 6px 18px -6px var(--electric-blue-glow);

                                                                                                        .ac-socials a:hover {
                                                                                                          background: var(--purple);
                                                                                                          color: #fff;
                                                                                                          border-color: var(--purple);
                                                                                                          transform: translateY(-3px);
                                                                                                          box-shadow: var(--shadow-sm);
                                                                                                        }

                                                                                                        /* --------------------------------------------------------------------------
   9. TECHNICAL SKILLS SECTION
   7. SKILLS
   -------------------------------------------------------------------------- */
                                                                                                        .skills-filter-nav {
                                                                                                          display: flex;
                                                                                                          justify-content: center;
                                                                                                          gap: 12px;
                                                                                                          margin-bottom: 40px;
                                                                                                          flex-wrap: wrap;

                                                                                                          .section-skills {
                                                                                                            padding: 110px 0;
                                                                                                            position: relative;
                                                                                                            background: var(--bg-alt);
                                                                                                            overflow: hidden;
                                                                                                          }

                                                                                                          .skill-filter-btn {
                                                                                                            padding: 9px 20px;
                                                                                                            border-radius: var(--radius-pill);
                                                                                                            font-family: var(--font-mono);
                                                                                                            font-size: 13px;
                                                                                                            font-weight: 500;
                                                                                                            color: var(--text-muted);
                                                                                                            background: var(--bg-card);
                                                                                                            border: 1px solid var(--border-subtle);
                                                                                                            transition: all var(--transition-fast);

                                                                                                            /* Purple diagonal band at top */
                                                                                                            .skills-band {
                                                                                                              position: absolute;
                                                                                                              top: 0;
                                                                                                              left: 0;
                                                                                                              right: 0;
                                                                                                              height: 200px;
                                                                                                              background: var(--grad-section);
                                                                                                              clip-path: polygon(0 0, 100% 0, 100% 60%, 0 100%);
                                                                                                              pointer-events: none;
                                                                                                            }

                                                                                                            .skill-filter-btn:hover,
                                                                                                            .skill-filter-btn.active {
                                                                                                              color: var(--text-primary);
                                                                                                              border-color: var(--electric-blue);
                                                                                                              background: var(--electric-blue-soft);
                                                                                                              box-shadow: 0 4px 16px -4px var(--electric-blue-glow);
                                                                                                            }

                                                                                                            .section-skills .container {
                                                                                                              position: relative;
                                                                                                              z-index: 1;
                                                                                                            }

                                                                                                            .skills-grid {
                                                                                                              display: grid;
                                                                                                              grid-template-columns: repeat(3, 1fr);
                                                                                                              gap: 22px;
                                                                                                              gap: 20px;
                                                                                                            }

                                                                                                            .skill-card {
                                                                                                              .sk-card {
                                                                                                                background: var(--surface);
                                                                                                                border: 1px solid var(--border);
                                                                                                                border-radius: var(--r-lg);
                                                                                                                padding: 24px;
                                                                                                                transition: transform var(--t-mid), box-shadow var(--t-mid), border-color var(--t-mid);
                                                                                                                position: relative;
                                                                                                                overflow: hidden;
                                                                                                                background: var(--bg-card);
                                                                                                                border: 1px solid var(--border-card);
                                                                                                                border-radius: var(--radius-md);
                                                                                                                padding: 24px;
                                                                                                                backdrop-filter: blur(14px);
                                                                                                                transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal), opacity var(--transition-fast);
                                                                                                                animation-delay: calc(var(--i) * 0.06s);
                                                                                                              }

                                                                                                              .skill-card::before {
                                                                                                                .sk-card::before {
                                                                                                                  content: '';
                                                                                                                  position: absolute;
                                                                                                                  inset: 0 0 auto 0;
                                                                                                                  top: 0;
                                                                                                                  left: 0;
                                                                                                                  right: 0;
                                                                                                                  height: 3px;
                                                                                                                  background: var(--grad-signature);
                                                                                                                  opacity: 0;
                                                                                                                  transition: opacity var(--transition-fast);
                                                                                                                  background: var(--grad-main);
                                                                                                                  transform: scaleX(0);
                                                                                                                  transform-origin: left;
                                                                                                                  transition: transform var(--t-mid);
                                                                                                                }

                                                                                                                .skill-card:hover {
                                                                                                                  .sk-card:hover {
                                                                                                                    transform: translateY(-6px);
                                                                                                                    border-color: var(--electric-blue);
                                                                                                                    box-shadow: var(--shadow-card-hover);
                                                                                                                    box-shadow: var(--shadow-md);
                                                                                                                    border-color: var(--border-med);
                                                                                                                  }

                                                                                                                  .sk-card:hover::before {
                                                                                                                    transform: scaleX(1);
                                                                                                                  }

                                                                                                                  .skill-card:hover::before {
                                                                                                                    opacity: 1;

                                                                                                                    .sk-icon {
                                                                                                                      width: 46px;
                                                                                                                      height: 46px;
                                                                                                                      border-radius: var(--r-md);
                                                                                                                      background: var(--purple-faint);
                                                                                                                      border: 1px solid var(--border);
                                                                                                                      display: flex;
                                                                                                                      align-items: center;
                                                                                                                      justify-content: center;
                                                                                                                      color: var(--purple);
                                                                                                                      font-size: 19px;
                                                                                                                      margin-bottom: 14px;
                                                                                                                      transition: all var(--t-fast);
                                                                                                                    }

                                                                                                                    .sk-card:hover .sk-icon {
                                                                                                                      background: var(--purple);
                                                                                                                      color: #fff;
                                                                                                                    }

                                                                                                                    .skill-top {
                                                                                                                      display: flex;
                                                                                                                      align-items: center;
                                                                                                                      gap: 16px;
                                                                                                                      margin-bottom: 20px;
                                                                                                                    }

                                                                                                                    .sk-info h4 {
                                                                                                                      font-family: var(--font-display);
                                                                                                                      font-size: 16px;
                                                                                                                      font-weight: 700;
                                                                                                                      color: var(--text);
                                                                                                                      margin-bottom: 2px;
                                                                                                                    }

                                                                                                                    .sk-info span {
                                                                                                                      font-family: var(--font-mono);
                                                                                                                      font-size: 11.5px;
                                                                                                                      color: var(--text-3);
                                                                                                                    }

                                                                                                                    .skill-icon {
                                                                                                                      width: 48px;
                                                                                                                      height: 48px;
                                                                                                                      border-radius: var(--radius-sm);
                                                                                                                      background: var(--electric-blue-soft);
                                                                                                                      border: 1px solid rgba(56, 189, 248, 0.25);

                                                                                                                      .sk-bar-wrap {
                                                                                                                        display: flex;
                                                                                                                        align-items: center;
                                                                                                                        justify-content: center;
                                                                                                                        color: var(--electric-blue);
                                                                                                                        font-size: 20px;
                                                                                                                        flex-shrink: 0;
                                                                                                                        transition: transform var(--transition-fast), background var(--transition-fast);
                                                                                                                        gap: 10px;
                                                                                                                        margin-top: 16px;
                                                                                                                      }

                                                                                                                      .skill-card:hover .skill-icon {
                                                                                                                        transform: translateY(-2px) scale(1.05);
                                                                                                                        background: rgba(56, 189, 248, 0.22);
                                                                                                                      }

                                                                                                                      .skill-meta h4 {
                                                                                                                        font-family: var(--font-display);
                                                                                                                        font-size: 16.5px;
                                                                                                                        color: var(--text-primary);
                                                                                                                        font-weight: 700;
                                                                                                                        margin-bottom: 2px;
                                                                                                                      }

                                                                                                                      .skill-meta span {
                                                                                                                        font-family: var(--font-mono);
                                                                                                                        font-size: 11.5px;
                                                                                                                        color: var(--text-muted);
                                                                                                                      }

                                                                                                                      .bar-track {
                                                                                                                        width: 100%;
                                                                                                                        height: 7px;
                                                                                                                        background: var(--bg-surface);
                                                                                                                        border: 1px solid var(--border-subtle);
                                                                                                                        border-radius: var(--radius-pill);

                                                                                                                        /* track */
                                                                                                                        .sk-bar-wrap>.sk-bar {
                                                                                                                          flex: 1;
                                                                                                                          height: 6px;
                                                                                                                          background: var(--border);
                                                                                                                          border-radius: var(--r-pill);
                                                                                                                          overflow: hidden;
                                                                                                                          position: relative;
                                                                                                                        }

                                                                                                                        .bar-fill {

                                                                                                                          /* fill — using ::after pseudo */
                                                                                                                          .sk-bar::after {
                                                                                                                            content: '';
                                                                                                                            position: absolute;
                                                                                                                            left: 0;
                                                                                                                            top: 0;
                                                                                                                            height: 100%;
                                                                                                                            border-radius: var(--radius-pill);
                                                                                                                            background: var(--grad-signature);
                                                                                                                            width: 0%;
                                                                                                                            background: var(--grad-main);
                                                                                                                            border-radius: var(--r-pill);
                                                                                                                            transition: width 1.4s var(--ease);
                                                                                                                          }

                                                                                                                          .bar-label {
                                                                                                                            display: flex;
                                                                                                                            justify-content: space-between;
                                                                                                                            margin-top: 10px;

                                                                                                                            .sk-pct {
                                                                                                                              font-family: var(--font-mono);
                                                                                                                              font-size: 11.5px;
                                                                                                                              color: var(--text-muted);
                                                                                                                            }

                                                                                                                            .bar-label .pct {
                                                                                                                              color: var(--electric-blue);
                                                                                                                              color: var(--purple);
                                                                                                                              font-weight: 600;
                                                                                                                              min-width: 34px;
                                                                                                                              text-align: right;
                                                                                                                            }

                                                                                                                            /* --------------------------------------------------------------------------
   10. MODERN PROJECT SLIDER (HORIZONTAL INFINITE LOOP)
   8. PROJECTS CAROUSEL
   -------------------------------------------------------------------------- */
                                                                                                                            .project-slider-wrapper {
                                                                                                                              .section-projects {
                                                                                                                                padding: 110px 0;
                                                                                                                                background: var(--bg);
                                                                                                                              }

                                                                                                                              .projects-head {
                                                                                                                                display: flex;
                                                                                                                                align-items: flex-end;
                                                                                                                                justify-content: space-between;
                                                                                                                                margin-bottom: 44px;
                                                                                                                                gap: 20px;
                                                                                                                                flex-wrap: wrap;
                                                                                                                              }

                                                                                                                              .projects-sub {
                                                                                                                                font-family: var(--font-mono);
                                                                                                                                font-size: 13px;
                                                                                                                                color: var(--text-3);
                                                                                                                                text-align: right;
                                                                                                                                max-width: 260px;
                                                                                                                              }

                                                                                                                              .carousel-wrap {
                                                                                                                                position: relative;
                                                                                                                                width: 100%;
                                                                                                                                padding: 10px 0 20px;
                                                                                                                                outline: none;
                                                                                                                              }

                                                                                                                              .slider-viewport {
                                                                                                                                .carousel-viewport {
                                                                                                                                  overflow: hidden;
                                                                                                                                  width: 100%;
                                                                                                                                  border-radius: var(--radius-xl);
                                                                                                                                  padding: 8px 4px;
                                                                                                                                  border-radius: var(--r-xl);
                                                                                                                                }

                                                                                                                                .slider-track {
                                                                                                                                  .carousel-track {
                                                                                                                                    display: flex;
                                                                                                                                    transition: transform 0.55s cubic-bezier(0.25, 1, 0.5, 1);
                                                                                                                                    will-change: transform;
                                                                                                                                    cursor: grab;
                                                                                                                                  }

                                                                                                                                  .carousel-track:active {
                                                                                                                                    cursor: grabbing;
                                                                                                                                  }

                                                                                                                                  .slider-track:active {
                                                                                                                                    cursor: grabbing;
                                                                                                                                  }

                                                                                                                                  .slider-slide {
                                                                                                                                    .c-slide {
                                                                                                                                      flex: 0 0 100%;
                                                                                                                                      width: 100%;
                                                                                                                                      min-width: 100%;
                                                                                                                                      max-width: 100%;
                                                                                                                                      padding: 0 8px;
                                                                                                                                      padding: 4px;
                                                                                                                                      box-sizing: border-box;
                                                                                                                                      user-select: none;
                                                                                                                                    }

                                                                                                                                    @media (min-width: 900px) {
                                                                                                                                      .slider-slide {
                                                                                                                                        flex: 0 0 100%;
                                                                                                                                      }
                                                                                                                                    }

                                                                                                                                    /* Large Attractive Project Card */
                                                                                                                                    .project-showcase-card {

                                                                                                                                      /* Project Card — two column: preview + info */
                                                                                                                                      .proj-card {
                                                                                                                                        display: grid;
                                                                                                                                        grid-template-columns: 1.15fr 0.85fr;
                                                                                                                                        background: var(--bg-card);
                                                                                                                                        border: 1px solid var(--border-card);
                                                                                                                                        border-radius: var(--radius-xl);
                                                                                                                                        grid-template-columns: 1.1fr 0.9fr;
                                                                                                                                        background: var(--surface);
                                                                                                                                        border: 1px solid var(--border);
                                                                                                                                        border-radius: var(--r-xl);
                                                                                                                                        overflow: hidden;
                                                                                                                                        box-shadow: var(--shadow-card);
                                                                                                                                        backdrop-filter: blur(16px);
                                                                                                                                        -webkit-backdrop-filter: blur(16px);
                                                                                                                                        transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
                                                                                                                                        min-height: 440px;
                                                                                                                                        min-height: 460px;
                                                                                                                                        transition: box-shadow var(--t-mid), border-color var(--t-mid);
                                                                                                                                      }

                                                                                                                                      .proj-card:hover {
                                                                                                                                        box-shadow: var(--shadow-lg);
                                                                                                                                        border-color: var(--border-med);
                                                                                                                                      }

                                                                                                                                      .project-showcase-card:hover {
                                                                                                                                        border-color: var(--electric-blue);
                                                                                                                                        box-shadow: var(--shadow-card-hover);
                                                                                                                                      }

                                                                                                                                      /* Mockup / Screenshot Container */
                                                                                                                                      .project-preview {
                                                                                                                                        background: var(--bg-surface);
                                                                                                                                        border-right: 1px solid var(--border-subtle);
                                                                                                                                        position: relative;

                                                                                                                                        /* Preview pane */
                                                                                                                                        .proj-preview {
                                                                                                                                          background: var(--bg-alt);
                                                                                                                                          border-right: 1px solid var(--border);
                                                                                                                                          display: flex;
                                                                                                                                          flex-direction: column;
                                                                                                                                          overflow: hidden;
                                                                                                                                        }

                                                                                                                                        .browser-header {
                                                                                                                                          .pp-bar {
                                                                                                                                            display: flex;
                                                                                                                                            align-items: center;
                                                                                                                                            justify-content: space-between;
                                                                                                                                            padding: 12px 18px;
                                                                                                                                            background: rgba(15, 23, 42, 0.5);
                                                                                                                                            border-bottom: 1px solid var(--border-subtle);
                                                                                                                                            background: rgba(124, 58, 237, 0.06);
                                                                                                                                            border-bottom: 1px solid var(--border);
                                                                                                                                          }

                                                                                                                                          .browser-dots {
                                                                                                                                            display: flex;
                                                                                                                                            gap: 6px;

                                                                                                                                            .pp-dots {
                                                                                                                                              display: flex;
                                                                                                                                              gap: 6px;
                                                                                                                                            }

                                                                                                                                            .pp-dots span {
                                                                                                                                              width: 10px;
                                                                                                                                              height: 10px;
                                                                                                                                              border-radius: 50%;
                                                                                                                                            }

                                                                                                                                            .browser-address {
                                                                                                                                              .pp-dots span:nth-child(1) {
                                                                                                                                                background: #ef4444;
                                                                                                                                              }

                                                                                                                                              .pp-dots span:nth-child(2) {
                                                                                                                                                background: #f59e0b;
                                                                                                                                              }

                                                                                                                                              .pp-dots span:nth-child(3) {
                                                                                                                                                background: #10b981;
                                                                                                                                              }

                                                                                                                                              .pp-url {
                                                                                                                                                font-family: var(--font-mono);
                                                                                                                                                font-size: 11px;
                                                                                                                                                color: var(--text-muted);
                                                                                                                                                background: rgba(0, 0, 0, 0.2);
                                                                                                                                                padding: 3px 14px;
                                                                                                                                                border-radius: var(--radius-pill);
                                                                                                                                                border: 1px solid var(--border-subtle);
                                                                                                                                                color: var(--text-3);
                                                                                                                                                display: flex;
                                                                                                                                                align-items: center;
                                                                                                                                                gap: 6px;
                                                                                                                                                background: var(--surface);
                                                                                                                                                padding: 4px 14px;
                                                                                                                                                border-radius: var(--r-pill);
                                                                                                                                                border: 1px solid var(--border);
                                                                                                                                              }

                                                                                                                                              .browser-address i {
                                                                                                                                                font-size: 9px;
                                                                                                                                                color: var(--emerald-accent);
                                                                                                                                              }

                                                                                                                                              .preview-content {
                                                                                                                                                .pp-url i {
                                                                                                                                                  font-size: 9px;
                                                                                                                                                  color: #10b981;
                                                                                                                                                }

                                                                                                                                                .pp-body {
                                                                                                                                                  flex: 1;
                                                                                                                                                  padding: 24px;
                                                                                                                                                  display: flex;
                                                                                                                                                  align-items: center;
                                                                                                                                                  justify-content: center;
                                                                                                                                                  position: relative;
                                                                                                                                                  background: radial-gradient(circle at 50% 50%, rgba(56, 189, 248, 0.08) 0%, transparent 80%);
                                                                                                                                                  padding: 28px;
                                                                                                                                                  background: radial-gradient(circle at 50% 50%, rgba(124, 58, 237, 0.07) 0%, transparent 75%);
                                                                                                                                                }

                                                                                                                                                /* Mockup UI Previews */
                                                                                                                                                .mockup-ui {
                                                                                                                                                  .pp-mockup {
                                                                                                                                                    width: 100%;
                                                                                                                                                    max-width: 440px;
                                                                                                                                                    background: var(--bg-card);
                                                                                                                                                    border: 1px solid var(--border-card);
                                                                                                                                                    border-radius: var(--radius-md);
                                                                                                                                                    padding: 18px;
                                                                                                                                                    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.4);
                                                                                                                                                    max-width: 380px;
                                                                                                                                                    background: var(--surface);
                                                                                                                                                    border: 1px solid var(--border);
                                                                                                                                                    border-radius: var(--r-lg);
                                                                                                                                                    padding: 20px;
                                                                                                                                                    box-shadow: var(--shadow-card);
                                                                                                                                                  }

                                                                                                                                                  .mockup-bar {
                                                                                                                                                    display: flex;
                                                                                                                                                    justify-content: space-between;
                                                                                                                                                    align-items: center;
                                                                                                                                                    margin-bottom: 16px;

                                                                                                                                                    .pm-label {
                                                                                                                                                      font-family: var(--font-display);
                                                                                                                                                      font-size: 14px;
                                                                                                                                                      font-weight: 700;
                                                                                                                                                      color: var(--text);
                                                                                                                                                      margin-bottom: 18px;
                                                                                                                                                      padding-bottom: 12px;
                                                                                                                                                      border-bottom: 1px solid var(--border);
                                                                                                                                                    }

                                                                                                                                                    .mockup-tag {
                                                                                                                                                      font-family: var(--font-mono);
                                                                                                                                                      font-size: 11px;
                                                                                                                                                      font-weight: 600;
                                                                                                                                                      color: var(--electric-blue);
                                                                                                                                                      background: var(--electric-blue-soft);
                                                                                                                                                      border: 1px solid rgba(56, 189, 248, 0.3);
                                                                                                                                                      padding: 3px 10px;
                                                                                                                                                      border-radius: var(--radius-pill);
                                                                                                                                                    }

                                                                                                                                                    .mockup-status {
                                                                                                                                                      font-family: var(--font-mono);
                                                                                                                                                      font-size: 11px;
                                                                                                                                                      color: var(--emerald-accent);
                                                                                                                                                      display: flex;
                                                                                                                                                      align-items: center;
                                                                                                                                                      gap: 6px;
                                                                                                                                                    }

                                                                                                                                                    .mockup-status::before {
                                                                                                                                                      content: '';
                                                                                                                                                      width: 6px;
                                                                                                                                                      height: 6px;
                                                                                                                                                      border-radius: 50%;
                                                                                                                                                      background: var(--emerald-accent);
                                                                                                                                                    }

                                                                                                                                                    .mockup-metrics {
                                                                                                                                                      .pm-metrics {
                                                                                                                                                        display: grid;
                                                                                                                                                        grid-template-columns: repeat(3, 1fr);
                                                                                                                                                        gap: 10px;
                                                                                                                                                        margin-bottom: 16px;
                                                                                                                                                      }

                                                                                                                                                      .metric-box {
                                                                                                                                                        background: var(--bg-surface);
                                                                                                                                                        border: 1px solid var(--border-subtle);
                                                                                                                                                        border-radius: var(--radius-sm);
                                                                                                                                                        padding: 10px 8px;

                                                                                                                                                        .pm-box {
                                                                                                                                                          background: var(--purple-faint);
                                                                                                                                                          border: 1px solid var(--border);
                                                                                                                                                          border-radius: var(--r-md);
                                                                                                                                                          padding: 12px 8px;
                                                                                                                                                          text-align: center;
                                                                                                                                                        }

                                                                                                                                                        .metric-box span {
                                                                                                                                                          font-family: var(--font-mono);
                                                                                                                                                          font-size: 10.5px;
                                                                                                                                                          color: var(--text-muted);

                                                                                                                                                          .pm-box strong {
                                                                                                                                                            display: block;
                                                                                                                                                          }

                                                                                                                                                          .metric-box strong {
                                                                                                                                                            font-family: var(--font-display);
                                                                                                                                                            font-size: 15px;
                                                                                                                                                            color: var(--text-primary);
                                                                                                                                                            font-weight: 700;
                                                                                                                                                            color: var(--purple);
                                                                                                                                                          }

                                                                                                                                                          .mockup-workflow {
                                                                                                                                                            .pm-box span {
                                                                                                                                                              font-family: var(--font-mono);
                                                                                                                                                              font-size: 10px;
                                                                                                                                                              color: var(--text-3);
                                                                                                                                                            }

                                                                                                                                                            .pm-flow {
                                                                                                                                                              display: flex;
                                                                                                                                                              align-items: center;
                                                                                                                                                              justify-content: space-between;
                                                                                                                                                              background: var(--bg-surface);
                                                                                                                                                              border: 1px solid var(--border-subtle);
                                                                                                                                                              border-radius: var(--radius-sm);
                                                                                                                                                              padding: 10px 14px;
                                                                                                                                                              background: var(--bg-alt);
                                                                                                                                                              border: 1px solid var(--border);
                                                                                                                                                              border-radius: var(--r-sm);
                                                                                                                                                              padding: 10px 12px;
                                                                                                                                                              font-family: var(--font-mono);
                                                                                                                                                              font-size: 11.5px;
                                                                                                                                                              color: var(--text-secondary);
                                                                                                                                                              font-size: 11px;
                                                                                                                                                              color: var(--text-2);
                                                                                                                                                              gap: 4px;
                                                                                                                                                              flex-wrap: wrap;
                                                                                                                                                            }

                                                                                                                                                            .pm-flow i {
                                                                                                                                                              color: var(--purple);
                                                                                                                                                            }

                                                                                                                                                            .pm-flow .fa-chevron-right {
                                                                                                                                                              color: var(--text-3);
                                                                                                                                                              font-size: 9px;
                                                                                                                                                            }

                                                                                                                                                            .mockup-workflow i {
                                                                                                                                                              color: var(--soft-purple);
                                                                                                                                                            }

                                                                                                                                                            /* Project Details Side */
                                                                                                                                                            .project-info-body {
                                                                                                                                                              padding: 36px 32px;

                                                                                                                                                              /* Info pane */
                                                                                                                                                              .proj-info {
                                                                                                                                                                padding: 38px 34px;
                                                                                                                                                                display: flex;
                                                                                                                                                                flex-direction: column;
                                                                                                                                                                justify-content: space-between;
                                                                                                                                                              }

                                                                                                                                                              .project-category-badge {
                                                                                                                                                                .pi-badge {
                                                                                                                                                                  display: inline-flex;
                                                                                                                                                                  font-family: var(--font-mono);
                                                                                                                                                                  font-size: 11.5px;
                                                                                                                                                                  font-weight: 600;
                                                                                                                                                                  font-weight: 700;
                                                                                                                                                                  text-transform: uppercase;
                                                                                                                                                                  letter-spacing: 0.08em;
                                                                                                                                                                  color: var(--electric-blue);
                                                                                                                                                                  margin-bottom: 12px;
                                                                                                                                                                  display: flex;
                                                                                                                                                                  align-items: center;
                                                                                                                                                                  gap: 8px;
                                                                                                                                                                  letter-spacing: 0.1em;
                                                                                                                                                                  color: var(--purple);
                                                                                                                                                                  background: var(--purple-faint);
                                                                                                                                                                  border: 1px solid var(--border-med);
                                                                                                                                                                  padding: 5px 12px;
                                                                                                                                                                  border-radius: var(--r-pill);
                                                                                                                                                                  margin-bottom: 14px;
                                                                                                                                                                }

                                                                                                                                                                .project-info-body h3 {
                                                                                                                                                                  .proj-info h3 {
                                                                                                                                                                    font-family: var(--font-display);
                                                                                                                                                                    font-size: 24px;
                                                                                                                                                                    font-size: 22px;
                                                                                                                                                                    font-weight: 700;
                                                                                                                                                                    color: var(--text-primary);
                                                                                                                                                                    color: var(--text);
                                                                                                                                                                    line-height: 1.28;
                                                                                                                                                                    margin-bottom: 14px;
                                                                                                                                                                    line-height: 1.25;
                                                                                                                                                                  }

                                                                                                                                                                  .project-info-body p {
                                                                                                                                                                    color: var(--text-secondary);
                                                                                                                                                                    font-size: 15px;

                                                                                                                                                                    .proj-info>p {
                                                                                                                                                                      font-size: 14.5px;
                                                                                                                                                                      color: var(--text-2);
                                                                                                                                                                      line-height: 1.65;
                                                                                                                                                                      margin-bottom: 22px;
                                                                                                                                                                    }

                                                                                                                                                                    .project-tech-tags {
                                                                                                                                                                      .pi-tags {
                                                                                                                                                                        display: flex;
                                                                                                                                                                        flex-wrap: wrap;
                                                                                                                                                                        gap: 8px;
                                                                                                                                                                        gap: 7px;
                                                                                                                                                                        margin-bottom: 28px;
                                                                                                                                                                      }

                                                                                                                                                                      .tech-tag {
                                                                                                                                                                        .pi-tags span {
                                                                                                                                                                          font-family: var(--font-mono);
                                                                                                                                                                          font-size: 11.5px;
                                                                                                                                                                          padding: 5px 12px;
                                                                                                                                                                          border-radius: var(--radius-pill);
                                                                                                                                                                          background: var(--bg-surface);
                                                                                                                                                                          color: var(--text-secondary);
                                                                                                                                                                          border: 1px solid var(--border-subtle);
                                                                                                                                                                          transition: all var(--transition-fast);
                                                                                                                                                                          border-radius: var(--r-pill);
                                                                                                                                                                          background: var(--bg-alt);
                                                                                                                                                                          border: 1px solid var(--border);
                                                                                                                                                                          color: var(--text-2);
                                                                                                                                                                          transition: all var(--t-fast);
                                                                                                                                                                        }

                                                                                                                                                                        .project-showcase-card:hover .tech-tag {
                                                                                                                                                                          border-color: rgba(56, 189, 248, 0.3);
                                                                                                                                                                          color: var(--electric-blue);

                                                                                                                                                                          .proj-card:hover .pi-tags span {
                                                                                                                                                                            border-color: var(--border-med);
                                                                                                                                                                            color: var(--purple);
                                                                                                                                                                          }

                                                                                                                                                                          .pi-actions {
                                                                                                                                                                            display: flex;
                                                                                                                                                                            gap: 12px;
                                                                                                                                                                          }

                                                                                                                                                                          .pi-btn-primary {
                                                                                                                                                                            flex: 1;
                                                                                                                                                                            text-align: center;
                                                                                                                                                                            padding: 12px;
                                                                                                                                                                            background: var(--grad-main);
                                                                                                                                                                            color: #fff;
                                                                                                                                                                            border-radius: var(--r-md);
                                                                                                                                                                            font-size: 14px;
                                                                                                                                                                            font-weight: 600;
                                                                                                                                                                            transition: transform var(--t-fast), box-shadow var(--t-fast);
                                                                                                                                                                          }

                                                                                                                                                                          .project-actions {
                                                                                                                                                                            display: flex;
                                                                                                                                                                            gap: 14px;
                                                                                                                                                                            align-items: center;

                                                                                                                                                                            .pi-btn-primary:hover {
                                                                                                                                                                              transform: translateY(-2px);
                                                                                                                                                                              box-shadow: var(--shadow-sm);
                                                                                                                                                                              color: #fff;
                                                                                                                                                                            }

                                                                                                                                                                            .pi-btn-ghost {
                                                                                                                                                                              flex: 1;
                                                                                                                                                                              text-align: center;
                                                                                                                                                                              padding: 11px;
                                                                                                                                                                              border: 1.5px solid var(--border-med);
                                                                                                                                                                              color: var(--purple);
                                                                                                                                                                              border-radius: var(--r-md);
                                                                                                                                                                              font-size: 14px;
                                                                                                                                                                              font-weight: 600;
                                                                                                                                                                              background: var(--purple-faint);
                                                                                                                                                                              transition: all var(--t-fast);
                                                                                                                                                                            }

                                                                                                                                                                            .pi-btn-ghost:hover {
                                                                                                                                                                              background: var(--purple);
                                                                                                                                                                              color: #fff;
                                                                                                                                                                              border-color: var(--purple);
                                                                                                                                                                              transform: translateY(-2px);
                                                                                                                                                                            }

                                                                                                                                                                            /* Slider Controls: Arrows and Dots */
                                                                                                                                                                            .slider-controls {

                                                                                                                                                                              /* Carousel controls */
                                                                                                                                                                              .carousel-controls {
                                                                                                                                                                                display: flex;
                                                                                                                                                                                align-items: center;
                                                                                                                                                                                justify-content: space-between;
                                                                                                                                                                                margin-top: 28px;
                                                                                                                                                                                padding: 0 6px;
                                                                                                                                                                                padding: 0 4px;
                                                                                                                                                                              }

                                                                                                                                                                              .slider-nav-arrows {
                                                                                                                                                                                display: flex;
                                                                                                                                                                                gap: 12px;
                                                                                                                                                                              }

                                                                                                                                                                              .slider-btn {
                                                                                                                                                                                width: 48px;
                                                                                                                                                                                height: 48px;

                                                                                                                                                                                .cc-arrows {
                                                                                                                                                                                  display: flex;
                                                                                                                                                                                  gap: 12px;
                                                                                                                                                                                }

                                                                                                                                                                                .cc-btn {
                                                                                                                                                                                  width: 50px;
                                                                                                                                                                                  height: 50px;
                                                                                                                                                                                  border-radius: 50%;
                                                                                                                                                                                  background: var(--bg-card);
                                                                                                                                                                                  border: 1.5px solid var(--border-strong);
                                                                                                                                                                                  color: var(--text-primary);
                                                                                                                                                                                  display: flex;
                                                                                                                                                                                  align-items: center;
                                                                                                                                                                                  justify-content: center;
                                                                                                                                                                                  font-size: 16px;
                                                                                                                                                                                  transition: all var(--transition-fast);
                                                                                                                                                                                  backdrop-filter: blur(10px);
                                                                                                                                                                                  background: var(--surface);
                                                                                                                                                                                  border: 1.5px solid var(--border-med);
                                                                                                                                                                                  color: var(--purple);
                                                                                                                                                                                  font-size: 17px;
                                                                                                                                                                                  display: flex;
                                                                                                                                                                                  align-items: center;
                                                                                                                                                                                  justify-content: center;
                                                                                                                                                                                  transition: all var(--t-fast);
                                                                                                                                                                                  box-shadow: var(--shadow-sm);
                                                                                                                                                                                }

                                                                                                                                                                                .slider-btn:hover {
                                                                                                                                                                                  background: var(--electric-blue-soft);
                                                                                                                                                                                  border-color: var(--electric-blue);
                                                                                                                                                                                  color: var(--electric-blue);

                                                                                                                                                                                  .cc-btn:hover {
                                                                                                                                                                                    background: var(--purple);
                                                                                                                                                                                    color: #fff;
                                                                                                                                                                                    border-color: var(--purple);
                                                                                                                                                                                    transform: translateY(-2px);
                                                                                                                                                                                    box-shadow: 0 6px 18px -4px var(--electric-blue-glow);
                                                                                                                                                                                    box-shadow: var(--shadow-md);
                                                                                                                                                                                  }

                                                                                                                                                                                  .slider-pagination {
                                                                                                                                                                                    display: flex;
                                                                                                                                                                                    align-items: center;
                                                                                                                                                                                    gap: 10px;
                                                                                                                                                                                  }

                                                                                                                                                                                  .slider-dot {
                                                                                                                                                                                    width: 10px;

                                                                                                                                                                                    .cc-dots {
                                                                                                                                                                                      display: flex;
                                                                                                                                                                                      align-items: center;
                                                                                                                                                                                      gap: 8px;
                                                                                                                                                                                    }

                                                                                                                                                                                    .cc-dot {
                                                                                                                                                                                      height: 10px;
                                                                                                                                                                                      border-radius: var(--radius-pill);
                                                                                                                                                                                      background: var(--border-strong);
                                                                                                                                                                                      border-radius: var(--r-pill);
                                                                                                                                                                                      background: var(--border-med);
                                                                                                                                                                                      border: none;
                                                                                                                                                                                      cursor: pointer;
                                                                                                                                                                                      transition: all var(--transition-normal);
                                                                                                                                                                                      transition: all 0.35s var(--ease);
                                                                                                                                                                                      width: 10px;
                                                                                                                                                                                    }

                                                                                                                                                                                    .slider-dot.active {
                                                                                                                                                                                      .cc-dot.active {
                                                                                                                                                                                        width: 32px;
                                                                                                                                                                                        background: var(--grad-signature);
                                                                                                                                                                                        box-shadow: 0 0 12px var(--electric-blue-glow);
                                                                                                                                                                                        background: var(--grad-main);
                                                                                                                                                                                        box-shadow: 0 0 10px rgba(124, 58, 237, 0.4);
                                                                                                                                                                                      }

                                                                                                                                                                                      /* --------------------------------------------------------------------------
   11. EDUCATION & EXPERIENCE SECTION
   9. EDUCATION
   -------------------------------------------------------------------------- */
                                                                                                                                                                                      .edu-panel {
                                                                                                                                                                                        .section-education {
                                                                                                                                                                                          padding: 110px 0;
                                                                                                                                                                                          background: var(--bg-alt);
                                                                                                                                                                                        }

                                                                                                                                                                                        .edu-layout {
                                                                                                                                                                                          display: grid;
                                                                                                                                                                                          grid-template-columns: 0.9fr 1.1fr;
                                                                                                                                                                                          border: 1px solid var(--border-card);
                                                                                                                                                                                          border-radius: var(--radius-xl);
                                                                                                                                                                                          overflow: hidden;
                                                                                                                                                                                          background: var(--bg-card);
                                                                                                                                                                                          box-shadow: var(--shadow-card);
                                                                                                                                                                                          backdrop-filter: blur(16px);
                                                                                                                                                                                          gap: 60px;
                                                                                                                                                                                          align-items: start;
                                                                                                                                                                                        }

                                                                                                                                                                                        .edu-left .section-eyebrow {
                                                                                                                                                                                          margin-bottom: 20px;
                                                                                                                                                                                        }

                                                                                                                                                                                        .edu-desc {
                                                                                                                                                                                          font-size: 16px;
                                                                                                                                                                                          color: var(--text-2);
                                                                                                                                                                                          line-height: 1.7;
                                                                                                                                                                                          margin-bottom: 36px;
                                                                                                                                                                                        }

                                                                                                                                                                                        .edu-left {
                                                                                                                                                                                          padding: 48px 40px;
                                                                                                                                                                                          background: var(--grad-soft);
                                                                                                                                                                                          border-right: 1px solid var(--border-subtle);

                                                                                                                                                                                          .edu-card {
                                                                                                                                                                                            display: flex;
                                                                                                                                                                                            flex-direction: column;
                                                                                                                                                                                            justify-content: center;
                                                                                                                                                                                            gap: 20px;
                                                                                                                                                                                            align-items: flex-start;
                                                                                                                                                                                            background: var(--surface);
                                                                                                                                                                                            border: 1px solid var(--border);
                                                                                                                                                                                            border-radius: var(--r-xl);
                                                                                                                                                                                            padding: 30px 28px;
                                                                                                                                                                                            box-shadow: var(--shadow-card);
                                                                                                                                                                                            position: relative;
                                                                                                                                                                                            overflow: hidden;
                                                                                                                                                                                          }

                                                                                                                                                                                          .edu-badge {
                                                                                                                                                                                            .edu-card::before {
                                                                                                                                                                                              content: '';
                                                                                                                                                                                              position: absolute;
                                                                                                                                                                                              left: 0;
                                                                                                                                                                                              top: 0;
                                                                                                                                                                                              bottom: 0;
                                                                                                                                                                                              width: 4px;
                                                                                                                                                                                              background: var(--grad-main);
                                                                                                                                                                                              border-radius: 4px 0 0 4px;
                                                                                                                                                                                            }

                                                                                                                                                                                            .educard-icon {
                                                                                                                                                                                              width: 48px;
                                                                                                                                                                                              height: 48px;
                                                                                                                                                                                              border-radius: var(--r-md);
                                                                                                                                                                                              background: var(--grad-main);
                                                                                                                                                                                              color: #fff;
                                                                                                                                                                                              font-size: 20px;
                                                                                                                                                                                              display: flex;
                                                                                                                                                                                              align-items: center;
                                                                                                                                                                                              justify-content: center;
                                                                                                                                                                                              flex-shrink: 0;
                                                                                                                                                                                              box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
                                                                                                                                                                                            }

                                                                                                                                                                                            .educard-badge {
                                                                                                                                                                                              font-family: var(--font-mono);
                                                                                                                                                                                              font-size: 12px;
                                                                                                                                                                                              font-weight: 600;
                                                                                                                                                                                              color: var(--electric-blue);
                                                                                                                                                                                              border: 1px solid rgba(56, 189, 248, 0.35);
                                                                                                                                                                                              background: var(--electric-blue-soft);
                                                                                                                                                                                              padding: 6px 14px;
                                                                                                                                                                                              border-radius: var(--radius-pill);
                                                                                                                                                                                              font-size: 11px;
                                                                                                                                                                                              color: #10b981;
                                                                                                                                                                                              background: rgba(16, 185, 129, 0.1);
                                                                                                                                                                                              border: 1px solid rgba(16, 185, 129, 0.3);
                                                                                                                                                                                              padding: 3px 10px;
                                                                                                                                                                                              border-radius: var(--r-pill);
                                                                                                                                                                                              width: fit-content;
                                                                                                                                                                                              margin-bottom: 22px;
                                                                                                                                                                                              display: inline-flex;
                                                                                                                                                                                              align-items: center;
                                                                                                                                                                                              gap: 8px;
                                                                                                                                                                                            }

                                                                                                                                                                                            .edu-left h3 {
                                                                                                                                                                                              font-family: var(--font-display);
                                                                                                                                                                                              font-size: 28px;
                                                                                                                                                                                              font-weight: 700;
                                                                                                                                                                                              color: var(--text-primary);
                                                                                                                                                                                              margin-bottom: 8px;
                                                                                                                                                                                              letter-spacing: -0.02em;
                                                                                                                                                                                            }

                                                                                                                                                                                            .edu-card h3 {
                                                                                                                                                                                              font-family: var(--font-display);
                                                                                                                                                                                              font-size: 22px;
                                                                                                                                                                                              font-weight: 700;
                                                                                                                                                                                              color: var(--text);
                                                                                                                                                                                              margin-bottom: 4px;
                                                                                                                                                                                            }

                                                                                                                                                                                            .edu-card>div>p {
                                                                                                                                                                                              font-size: 15px;
                                                                                                                                                                                              color: var(--text-2);
                                                                                                                                                                                              font-weight: 500;
                                                                                                                                                                                              margin-bottom: 10px;
                                                                                                                                                                                            }

                                                                                                                                                                                            .educard-meta {
                                                                                                                                                                                              font-family: var(--font-mono);
                                                                                                                                                                                              font-size: 12px;
                                                                                                                                                                                              color: var(--text-3);
                                                                                                                                                                                              display: flex;
                                                                                                                                                                                              align-items: center;
                                                                                                                                                                                              gap: 8px;
                                                                                                                                                                                            }

                                                                                                                                                                                            .edu-left p {
                                                                                                                                                                                              color: var(--text-secondary);
                                                                                                                                                                                              font-size: 16px;
                                                                                                                                                                                              font-weight: 500;
                                                                                                                                                                                            }

                                                                                                                                                                                            .edu-left .edu-meta {
                                                                                                                                                                                              margin-top: 24px;

                                                                                                                                                                                              .edu-focus-title {
                                                                                                                                                                                                font-family: var(--font-mono);
                                                                                                                                                                                                font-size: 13px;
                                                                                                                                                                                                color: var(--text-muted);
                                                                                                                                                                                                display: flex;
                                                                                                                                                                                                align-items: center;
                                                                                                                                                                                                gap: 10px;
                                                                                                                                                                                              }

                                                                                                                                                                                              .edu-right {
                                                                                                                                                                                                padding: 48px 40px;
                                                                                                                                                                                              }

                                                                                                                                                                                              .edu-right h4 {
                                                                                                                                                                                                font-family: var(--font-mono);
                                                                                                                                                                                                font-size: 13px;
                                                                                                                                                                                                font-size: 12px;
                                                                                                                                                                                                letter-spacing: 0.1em;
                                                                                                                                                                                                text-transform: uppercase;
                                                                                                                                                                                                color: var(--text-muted);
                                                                                                                                                                                                margin-bottom: 24px;
                                                                                                                                                                                                color: var(--purple);
                                                                                                                                                                                                margin-bottom: 22px;
                                                                                                                                                                                                font-weight: 600;
                                                                                                                                                                                              }

                                                                                                                                                                                              .focus-list {
                                                                                                                                                                                                .edu-focus-grid {
                                                                                                                                                                                                  display: grid;
                                                                                                                                                                                                  grid-template-columns: repeat(2, 1fr);
                                                                                                                                                                                                  gap: 14px;
                                                                                                                                                                                                  grid-template-columns: 1fr 1fr;
                                                                                                                                                                                                  gap: 12px;
                                                                                                                                                                                                }

                                                                                                                                                                                                .focus-item {
                                                                                                                                                                                                  .ef-item {
                                                                                                                                                                                                    display: flex;
                                                                                                                                                                                                    align-items: center;
                                                                                                                                                                                                    gap: 12px;
                                                                                                                                                                                                    gap: 10px;
                                                                                                                                                                                                    font-size: 14.5px;
                                                                                                                                                                                                    color: var(--text-secondary);
                                                                                                                                                                                                    padding: 10px 14px;
                                                                                                                                                                                                    background: var(--bg-surface);
                                                                                                                                                                                                    border: 1px solid var(--border-subtle);
                                                                                                                                                                                                    border-radius: var(--radius-sm);
                                                                                                                                                                                                    transition: all var(--transition-fast);
                                                                                                                                                                                                    color: var(--text-2);
                                                                                                                                                                                                    padding: 12px 16px;
                                                                                                                                                                                                    background: var(--surface);
                                                                                                                                                                                                    border: 1px solid var(--border);
                                                                                                                                                                                                    border-radius: var(--r-md);
                                                                                                                                                                                                    transition: all var(--t-fast);
                                                                                                                                                                                                  }

                                                                                                                                                                                                  .ef-item i {
                                                                                                                                                                                                    color: var(--purple);
                                                                                                                                                                                                    flex-shrink: 0;
                                                                                                                                                                                                    font-size: 12px;
                                                                                                                                                                                                  }

                                                                                                                                                                                                  .ef-item:hover {
                                                                                                                                                                                                    border-color: var(--purple);
                                                                                                                                                                                                    color: var(--purple);
                                                                                                                                                                                                    transform: translateX(4px);
                                                                                                                                                                                                  }

                                                                                                                                                                                                  .focus-item:hover {
                                                                                                                                                                                                    color: var(--text-primary);
                                                                                                                                                                                                    border-color: var(--electric-blue);
                                                                                                                                                                                                    transform: translateX(4px);
                                                                                                                                                                                                    background: var(--electric-blue-soft);
                                                                                                                                                                                                  }

                                                                                                                                                                                                  .focus-item i {
                                                                                                                                                                                                    color: var(--electric-blue);
                                                                                                                                                                                                    font-size: 13px;
                                                                                                                                                                                                    flex-shrink: 0;
                                                                                                                                                                                                  }

                                                                                                                                                                                                  /* --------------------------------------------------------------------------
   12. SERVICES SECTION
   10. SERVICES
   -------------------------------------------------------------------------- */
                                                                                                                                                                                                  .services-grid {
                                                                                                                                                                                                    .section-services {
                                                                                                                                                                                                      padding: 110px 0;
                                                                                                                                                                                                      background: var(--bg);
                                                                                                                                                                                                    }

                                                                                                                                                                                                    .srv-grid {
                                                                                                                                                                                                      display: grid;
                                                                                                                                                                                                      grid-template-columns: repeat(3, 1fr);
                                                                                                                                                                                                      gap: 24px;
                                                                                                                                                                                                      gap: 22px;
                                                                                                                                                                                                    }

                                                                                                                                                                                                    .service-card {
                                                                                                                                                                                                      padding: 32px 28px;
                                                                                                                                                                                                      border: 1px solid var(--border-card);
                                                                                                                                                                                                      border-radius: var(--radius-lg);
                                                                                                                                                                                                      background: var(--bg-card);
                                                                                                                                                                                                      backdrop-filter: blur(14px);
                                                                                                                                                                                                      transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);

                                                                                                                                                                                                      .srv-card {
                                                                                                                                                                                                        padding: 32px 26px;
                                                                                                                                                                                                        background: var(--surface);
                                                                                                                                                                                                        border: 1px solid var(--border);
                                                                                                                                                                                                        border-radius: var(--r-lg);
                                                                                                                                                                                                        position: relative;
                                                                                                                                                                                                        overflow: hidden;
                                                                                                                                                                                                        transition: transform var(--t-mid), box-shadow var(--t-mid), border-color var(--t-mid);
                                                                                                                                                                                                        animation-delay: calc(var(--i) * 0.07s);
                                                                                                                                                                                                      }

                                                                                                                                                                                                      .service-card::after {
                                                                                                                                                                                                        .srv-card::after {
                                                                                                                                                                                                          content: '';
                                                                                                                                                                                                          position: absolute;
                                                                                                                                                                                                          left: 0;
                                                                                                                                                                                                          right: 0;
                                                                                                                                                                                                          bottom: 0;
                                                                                                                                                                                                          bottom: 0;
                                                                                                                                                                                                          left: 0;
                                                                                                                                                                                                          right: 0;
                                                                                                                                                                                                          height: 3px;
                                                                                                                                                                                                          background: var(--grad-signature);
                                                                                                                                                                                                          background: var(--grad-main);
                                                                                                                                                                                                          transform: scaleX(0);
                                                                                                                                                                                                          transform-origin: left;
                                                                                                                                                                                                          transition: transform 0.4s var(--ease);
                                                                                                                                                                                                          transition: transform var(--t-mid);
                                                                                                                                                                                                        }

                                                                                                                                                                                                        .service-card:hover {
                                                                                                                                                                                                          .srv-card:hover {
                                                                                                                                                                                                            transform: translateY(-8px);
                                                                                                                                                                                                            border-color: var(--electric-blue);
                                                                                                                                                                                                            box-shadow: var(--shadow-card-hover);
                                                                                                                                                                                                            box-shadow: var(--shadow-md);
                                                                                                                                                                                                            border-color: var(--border-med);
                                                                                                                                                                                                          }

                                                                                                                                                                                                          .service-card:hover::after {
                                                                                                                                                                                                            transform: scaleX(1);
                                                                                                                                                                                                          }

                                                                                                                                                                                                          .service-header {
                                                                                                                                                                                                            display: flex;
                                                                                                                                                                                                            align-items: center;
                                                                                                                                                                                                            justify-content: space-between;
                                                                                                                                                                                                            margin-bottom: 22px;
                                                                                                                                                                                                          }

                                                                                                                                                                                                          .service-icon {
                                                                                                                                                                                                            width: 50px;
                                                                                                                                                                                                            height: 50px;
                                                                                                                                                                                                            border-radius: var(--radius-md);
                                                                                                                                                                                                            background: var(--grad-signature);
                                                                                                                                                                                                            display: flex;
                                                                                                                                                                                                            align-items: center;
                                                                                                                                                                                                            justify-content: center;
                                                                                                                                                                                                            color: #ffffff;
                                                                                                                                                                                                            font-size: 20px;
                                                                                                                                                                                                            box-shadow: 0 8px 20px -6px rgba(56, 189, 248, 0.45);
                                                                                                                                                                                                            transition: transform var(--transition-fast);
                                                                                                                                                                                                          }

                                                                                                                                                                                                          .service-card:hover .service-icon {
                                                                                                                                                                                                            transform: translateY(-3px) rotate(-4deg);
                                                                                                                                                                                                          }

                                                                                                                                                                                                          .service-num {
                                                                                                                                                                                                            .srv-card:hover::after {
                                                                                                                                                                                                              transform: scaleX(1);
                                                                                                                                                                                                            }

                                                                                                                                                                                                            .srv-num {
                                                                                                                                                                                                              font-family: var(--font-mono);
                                                                                                                                                                                                              font-size: 13px;
                                                                                                                                                                                                              font-size: 12px;
                                                                                                                                                                                                              color: var(--text-3);
                                                                                                                                                                                                              font-weight: 600;
                                                                                                                                                                                                              color: var(--text-dim);
                                                                                                                                                                                                              margin-bottom: 18px;
                                                                                                                                                                                                            }

                                                                                                                                                                                                            .service-card h4 {
                                                                                                                                                                                                              font-family: var(--font-display);
                                                                                                                                                                                                              font-size: 18px;
                                                                                                                                                                                                              font-weight: 700;
                                                                                                                                                                                                              color: var(--text-primary);
                                                                                                                                                                                                              margin-bottom: 12px;
                                                                                                                                                                                                              line-height: 1.35;

                                                                                                                                                                                                              .srv-icon {
                                                                                                                                                                                                                width: 52px;
                                                                                                                                                                                                                height: 52px;
                                                                                                                                                                                                                border-radius: var(--r-md);
                                                                                                                                                                                                                background: var(--grad-main);
                                                                                                                                                                                                                color: #fff;
                                                                                                                                                                                                                font-size: 20px;
                                                                                                                                                                                                                display: flex;
                                                                                                                                                                                                                align-items: center;
                                                                                                                                                                                                                justify-content: center;
                                                                                                                                                                                                                margin-bottom: 18px;
                                                                                                                                                                                                                box-shadow: 0 6px 18px rgba(124, 58, 237, 0.38);
                                                                                                                                                                                                                transition: transform var(--t-fast);
                                                                                                                                                                                                              }

                                                                                                                                                                                                              .srv-card:hover .srv-icon {
                                                                                                                                                                                                                transform: translateY(-3px) rotate(-5deg);
                                                                                                                                                                                                              }

                                                                                                                                                                                                              .srv-card h4 {
                                                                                                                                                                                                                font-family: var(--font-display);
                                                                                                                                                                                                                font-size: 18px;
                                                                                                                                                                                                                font-weight: 700;
                                                                                                                                                                                                                color: var(--text);
                                                                                                                                                                                                                margin-bottom: 10px;
                                                                                                                                                                                                              }

                                                                                                                                                                                                              .srv-card p {
                                                                                                                                                                                                                font-size: 14px;
                                                                                                                                                                                                                color: var(--text-2);
                                                                                                                                                                                                                line-height: 1.6;
                                                                                                                                                                                                              }

                                                                                                                                                                                                              .service-card p {
                                                                                                                                                                                                                font-size: 14.5px;
                                                                                                                                                                                                                color: var(--text-secondary);
                                                                                                                                                                                                                line-height: 1.6;
                                                                                                                                                                                                              }

                                                                                                                                                                                                              /* --------------------------------------------------------------------------
   13. CONTACT SECTION
   11. CONTACT
   -------------------------------------------------------------------------- */
                                                                                                                                                                                                              .contact-grid {
                                                                                                                                                                                                                .section-contact {
                                                                                                                                                                                                                  padding: 110px 0;
                                                                                                                                                                                                                  background: var(--bg-alt);
                                                                                                                                                                                                                  position: relative;
                                                                                                                                                                                                                  overflow: hidden;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .contact-blob {
                                                                                                                                                                                                                  position: absolute;
                                                                                                                                                                                                                  width: 500px;
                                                                                                                                                                                                                  height: 500px;
                                                                                                                                                                                                                  top: -100px;
                                                                                                                                                                                                                  right: -150px;
                                                                                                                                                                                                                  border-radius: 50%;
                                                                                                                                                                                                                  background: radial-gradient(circle, rgba(124, 58, 237, 0.12), transparent 70%);
                                                                                                                                                                                                                  filter: blur(60px);
                                                                                                                                                                                                                  pointer-events: none;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .contact-layout {
                                                                                                                                                                                                                  display: grid;
                                                                                                                                                                                                                  grid-template-columns: 0.85fr 1.15fr;
                                                                                                                                                                                                                  gap: 40px;
                                                                                                                                                                                                                  gap: 50px;
                                                                                                                                                                                                                  align-items: start;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .contact-info-card {
                                                                                                                                                                                                                  border: 1px solid var(--border-card);
                                                                                                                                                                                                                  border-radius: var(--radius-xl);
                                                                                                                                                                                                                  background: var(--bg-card);
                                                                                                                                                                                                                  padding: 40px 36px;
                                                                                                                                                                                                                  box-shadow: var(--shadow-card);
                                                                                                                                                                                                                  backdrop-filter: blur(16px);
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .contact-info-card h3 {
                                                                                                                                                                                                                  font-family: var(--font-display);
                                                                                                                                                                                                                  font-size: 22px;
                                                                                                                                                                                                                  font-weight: 700;
                                                                                                                                                                                                                  color: var(--text-primary);
                                                                                                                                                                                                                  margin-bottom: 12px;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .contact-info-card p.contact-lead {
                                                                                                                                                                                                                  font-size: 15px;
                                                                                                                                                                                                                  color: var(--text-secondary);
                                                                                                                                                                                                                  margin-bottom: 30px;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .contact-row {
                                                                                                                                                                                                                  .contact-info .section-eyebrow {
                                                                                                                                                                                                                    margin-bottom: 20px;
                                                                                                                                                                                                                  }

                                                                                                                                                                                                                  .contact-desc {
                                                                                                                                                                                                                    font-size: 16px;
                                                                                                                                                                                                                    color: var(--text-2);
                                                                                                                                                                                                                    line-height: 1.7;
                                                                                                                                                                                                                    margin-bottom: 36px;
                                                                                                                                                                                                                  }

                                                                                                                                                                                                                  .ci-items {
                                                                                                                                                                                                                    display: flex;
                                                                                                                                                                                                                    flex-direction: column;
                                                                                                                                                                                                                    gap: 0;
                                                                                                                                                                                                                  }

                                                                                                                                                                                                                  .ci-item {
                                                                                                                                                                                                                    display: flex;
                                                                                                                                                                                                                    align-items: center;
                                                                                                                                                                                                                    gap: 16px;
                                                                                                                                                                                                                    padding: 16px 0;
                                                                                                                                                                                                                    border-bottom: 1px solid var(--border-subtle);
                                                                                                                                                                                                                    transition: padding-left var(--transition-fast);
                                                                                                                                                                                                                    border-bottom: 1px solid var(--border);
                                                                                                                                                                                                                  }

                                                                                                                                                                                                                  .contact-row:hover {
                                                                                                                                                                                                                    padding-left: 6px;
                                                                                                                                                                                                                  }

                                                                                                                                                                                                                  .contact-row:last-of-type {
                                                                                                                                                                                                                    border-bottom: none;
                                                                                                                                                                                                                  }

                                                                                                                                                                                                                  .contact-row .ic {
                                                                                                                                                                                                                    width: 46px;
                                                                                                                                                                                                                    height: 46px;
                                                                                                                                                                                                                    border-radius: var(--radius-md);
                                                                                                                                                                                                                    background: var(--electric-blue-soft);
                                                                                                                                                                                                                    color: var(--electric-blue);
                                                                                                                                                                                                                    display: flex;
                                                                                                                                                                                                                    align-items: center;
                                                                                                                                                                                                                    justify-content: center;

                                                                                                                                                                                                                    .ci-item:last-child {
                                                                                                                                                                                                                      border-bottom: none;
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    .ci-icon {
                                                                                                                                                                                                                      width: 44px;
                                                                                                                                                                                                                      height: 44px;
                                                                                                                                                                                                                      border-radius: var(--r-md);
                                                                                                                                                                                                                      background: var(--purple-faint);
                                                                                                                                                                                                                      border: 1px solid var(--border-med);
                                                                                                                                                                                                                      color: var(--purple);
                                                                                                                                                                                                                      font-size: 18px;
                                                                                                                                                                                                                      display: flex;
                                                                                                                                                                                                                      align-items: center;
                                                                                                                                                                                                                      justify-content: center;
                                                                                                                                                                                                                      flex-shrink: 0;
                                                                                                                                                                                                                      transition: all var(--transition-fast);
                                                                                                                                                                                                                      transition: all var(--t-fast);
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    .contact-row:hover .ic {
                                                                                                                                                                                                                      background: var(--grad-signature);
                                                                                                                                                                                                                      color: #ffffff;
                                                                                                                                                                                                                      transform: scale(1.05);
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    .contact-row div span {
                                                                                                                                                                                                                      .ci-item:hover .ci-icon {
                                                                                                                                                                                                                        background: var(--purple);
                                                                                                                                                                                                                        color: #fff;
                                                                                                                                                                                                                      }

                                                                                                                                                                                                                      .ci-item div span {
                                                                                                                                                                                                                        display: block;
                                                                                                                                                                                                                        font-family: var(--font-mono);
                                                                                                                                                                                                                        font-size: 11.5px;
                                                                                                                                                                                                                        color: var(--text-muted);
                                                                                                                                                                                                                        font-size: 11px;
                                                                                                                                                                                                                        color: var(--text-3);
                                                                                                                                                                                                                        text-transform: uppercase;
                                                                                                                                                                                                                        letter-spacing: 0.06em;
                                                                                                                                                                                                                        margin-bottom: 3px;
                                                                                                                                                                                                                        margin-bottom: 2px;
                                                                                                                                                                                                                      }

                                                                                                                                                                                                                      .contact-row div a,
                                                                                                                                                                                                                      .contact-row div p {
                                                                                                                                                                                                                        color: var(--text-primary);
                                                                                                                                                                                                                        font-size: 15px;
                                                                                                                                                                                                                        font-weight: 600;
                                                                                                                                                                                                                        transition: color var(--transition-fast);

                                                                                                                                                                                                                        .ci-item div a,
                                                                                                                                                                                                                        .ci-item div p {
                                                                                                                                                                                                                          font-size: 15px;
                                                                                                                                                                                                                          font-weight: 600;
                                                                                                                                                                                                                          color: var(--text);
                                                                                                                                                                                                                          transition: color var(--t-fast);
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .ci-item div a:hover {
                                                                                                                                                                                                                          color: var(--purple);
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .ci-socials {
                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                          gap: 12px;
                                                                                                                                                                                                                          margin-top: 30px;
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .cis-btn {
                                                                                                                                                                                                                          width: 44px;
                                                                                                                                                                                                                          height: 44px;
                                                                                                                                                                                                                          border-radius: var(--r-md);
                                                                                                                                                                                                                          border: 1px solid var(--border-med);
                                                                                                                                                                                                                          background: var(--purple-faint);
                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                          align-items: center;
                                                                                                                                                                                                                          justify-content: center;
                                                                                                                                                                                                                          color: var(--purple);
                                                                                                                                                                                                                          font-size: 18px;
                                                                                                                                                                                                                          transition: all var(--t-fast);
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .contact-row div a:hover {
                                                                                                                                                                                                                          color: var(--electric-blue);
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .contact-socials {
                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                          gap: 14px;
                                                                                                                                                                                                                          margin-top: 32px;
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .social-btn {
                                                                                                                                                                                                                          width: 44px;
                                                                                                                                                                                                                          height: 44px;
                                                                                                                                                                                                                          border-radius: var(--radius-md);
                                                                                                                                                                                                                          border: 1px solid var(--border-strong);
                                                                                                                                                                                                                          background: var(--bg-surface);
                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                          align-items: center;
                                                                                                                                                                                                                          justify-content: center;
                                                                                                                                                                                                                          color: var(--text-secondary);
                                                                                                                                                                                                                          font-size: 17px;
                                                                                                                                                                                                                          transition: all var(--transition-fast);
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        .social-btn:hover {
                                                                                                                                                                                                                          border-color: var(--electric-blue);
                                                                                                                                                                                                                          color: var(--electric-blue);
                                                                                                                                                                                                                          background: var(--electric-blue-soft);

                                                                                                                                                                                                                          .cis-btn:hover {
                                                                                                                                                                                                                            background: var(--purple);
                                                                                                                                                                                                                            color: #fff;
                                                                                                                                                                                                                            border-color: var(--purple);
                                                                                                                                                                                                                            transform: translateY(-3px);
                                                                                                                                                                                                                            box-shadow: 0 8px 20px -8px var(--electric-blue-glow);
                                                                                                                                                                                                                            box-shadow: var(--shadow-sm);
                                                                                                                                                                                                                          }

                                                                                                                                                                                                                          /* Contact form */
                                                                                                                                                                                                                          .contact-form {
                                                                                                                                                                                                                            border: 1px solid var(--border-card);
                                                                                                                                                                                                                            border-radius: var(--radius-xl);
                                                                                                                                                                                                                            background: var(--bg-card);
                                                                                                                                                                                                                            background: var(--surface);
                                                                                                                                                                                                                            border: 1px solid var(--border);
                                                                                                                                                                                                                            border-radius: var(--r-xl);
                                                                                                                                                                                                                            padding: 40px 36px;
                                                                                                                                                                                                                            box-shadow: var(--shadow-card);
                                                                                                                                                                                                                            backdrop-filter: blur(16px);
                                                                                                                                                                                                                          }

                                                                                                                                                                                                                          .form-row {
                                                                                                                                                                                                                            display: grid;
                                                                                                                                                                                                                            grid-template-columns: 1fr 1fr;
                                                                                                                                                                                                                            gap: 18px;
                                                                                                                                                                                                                            margin-bottom: 18px;
                                                                                                                                                                                                                          }

                                                                                                                                                                                                                          .field {
                                                                                                                                                                                                                            display: flex;
                                                                                                                                                                                                                            flex-direction: column;
                                                                                                                                                                                                                            gap: 8px;
                                                                                                                                                                                                                            margin-bottom: 18px;
                                                                                                                                                                                                                          }

                                                                                                                                                                                                                          .field label {
                                                                                                                                                                                                                            .cf-row {
                                                                                                                                                                                                                              display: grid;
                                                                                                                                                                                                                              grid-template-columns: 1fr 1fr;
                                                                                                                                                                                                                              gap: 18px;
                                                                                                                                                                                                                              margin-bottom: 18px;
                                                                                                                                                                                                                            }

                                                                                                                                                                                                                            .cf-field {
                                                                                                                                                                                                                              display: flex;
                                                                                                                                                                                                                              flex-direction: column;
                                                                                                                                                                                                                              gap: 8px;
                                                                                                                                                                                                                              margin-bottom: 18px;
                                                                                                                                                                                                                            }

                                                                                                                                                                                                                            .cf-field label {
                                                                                                                                                                                                                              font-family: var(--font-mono);
                                                                                                                                                                                                                              font-size: 12px;
                                                                                                                                                                                                                              font-weight: 600;
                                                                                                                                                                                                                              color: var(--text-muted);
                                                                                                                                                                                                                              color: var(--text-3);
                                                                                                                                                                                                                              text-transform: uppercase;
                                                                                                                                                                                                                              letter-spacing: 0.06em;
                                                                                                                                                                                                                            }

                                                                                                                                                                                                                            .field input,
                                                                                                                                                                                                                            .field textarea {
                                                                                                                                                                                                                              background: var(--bg-input);
                                                                                                                                                                                                                              border: 1.5px solid var(--border-strong);
                                                                                                                                                                                                                              border-radius: var(--radius-md);

                                                                                                                                                                                                                              .cf-field input,
                                                                                                                                                                                                                              .cf-field textarea {
                                                                                                                                                                                                                                background: var(--bg);
                                                                                                                                                                                                                                border: 1.5px solid var(--border);
                                                                                                                                                                                                                                border-radius: var(--r-md);
                                                                                                                                                                                                                                padding: 14px 16px;
                                                                                                                                                                                                                                color: var(--text-primary);
                                                                                                                                                                                                                                color: var(--text);
                                                                                                                                                                                                                                font-size: 15px;
                                                                                                                                                                                                                                transition: all var(--transition-fast);
                                                                                                                                                                                                                                transition: all var(--t-fast);
                                                                                                                                                                                                                              }

                                                                                                                                                                                                                              .field input::placeholder,
                                                                                                                                                                                                                              .field textarea::placeholder {
                                                                                                                                                                                                                                color: var(--text-dim);
                                                                                                                                                                                                                              }

                                                                                                                                                                                                                              .field input:focus,
                                                                                                                                                                                                                              .field textarea:focus {
                                                                                                                                                                                                                                border-color: var(--electric-blue);
                                                                                                                                                                                                                                background: var(--bg-surface);
                                                                                                                                                                                                                                box-shadow: 0 0 0 4px var(--electric-blue-soft);

                                                                                                                                                                                                                                .cf-field input::placeholder,
                                                                                                                                                                                                                                .cf-field textarea::placeholder {
                                                                                                                                                                                                                                  color: var(--text-3);
                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                .cf-field input:focus,
                                                                                                                                                                                                                                .cf-field textarea:focus {
                                                                                                                                                                                                                                  border-color: var(--purple);
                                                                                                                                                                                                                                  background: var(--surface);
                                                                                                                                                                                                                                  box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.1);
                                                                                                                                                                                                                                  outline: none;
                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                .field textarea {
                                                                                                                                                                                                                                  resize: vertical;
                                                                                                                                                                                                                                  min-height: 130px;
                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                .form-note {
                                                                                                                                                                                                                                  font-size: 13px;
                                                                                                                                                                                                                                  color: var(--text-muted);
                                                                                                                                                                                                                                  margin-top: 16px;

                                                                                                                                                                                                                                  .cf-field textarea {
                                                                                                                                                                                                                                    resize: vertical;
                                                                                                                                                                                                                                    min-height: 130px;
                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                  .cf-submit {
                                                                                                                                                                                                                                    width: 100%;
                                                                                                                                                                                                                                    padding: 15px;
                                                                                                                                                                                                                                    background: var(--grad-main);
                                                                                                                                                                                                                                    color: #fff;
                                                                                                                                                                                                                                    border-radius: var(--r-md);
                                                                                                                                                                                                                                    font-size: 15px;
                                                                                                                                                                                                                                    font-weight: 700;
                                                                                                                                                                                                                                    display: flex;
                                                                                                                                                                                                                                    align-items: center;
                                                                                                                                                                                                                                    gap: 8px;
                                                                                                                                                                                                                                    justify-content: center;
                                                                                                                                                                                                                                    gap: 10px;
                                                                                                                                                                                                                                    box-shadow: 0 6px 22px rgba(124, 58, 237, 0.4);
                                                                                                                                                                                                                                    transition: all var(--t-fast);
                                                                                                                                                                                                                                    position: relative;
                                                                                                                                                                                                                                    overflow: hidden;
                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                  .form-success {
                                                                                                                                                                                                                                    .cf-submit::after {
                                                                                                                                                                                                                                      content: '';
                                                                                                                                                                                                                                      position: absolute;
                                                                                                                                                                                                                                      top: 0;
                                                                                                                                                                                                                                      left: -100%;
                                                                                                                                                                                                                                      width: 60%;
                                                                                                                                                                                                                                      height: 100%;
                                                                                                                                                                                                                                      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
                                                                                                                                                                                                                                      transform: skewX(-20deg);
                                                                                                                                                                                                                                      transition: left 0.6s var(--ease);
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .cf-submit:hover {
                                                                                                                                                                                                                                      transform: translateY(-2px);
                                                                                                                                                                                                                                      box-shadow: 0 10px 32px rgba(124, 58, 237, 0.52);
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .cf-submit:hover::after {
                                                                                                                                                                                                                                      left: 150%;
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .cf-note {
                                                                                                                                                                                                                                      font-size: 12.5px;
                                                                                                                                                                                                                                      color: var(--text-3);
                                                                                                                                                                                                                                      margin-top: 14px;
                                                                                                                                                                                                                                      display: flex;
                                                                                                                                                                                                                                      align-items: center;
                                                                                                                                                                                                                                      gap: 7px;
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .cf-note i {
                                                                                                                                                                                                                                      color: var(--purple);
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .cf-success {
                                                                                                                                                                                                                                      display: none;
                                                                                                                                                                                                                                      align-items: center;
                                                                                                                                                                                                                                      gap: 12px;
                                                                                                                                                                                                                                      margin-top: 18px;
                                                                                                                                                                                                                                      margin-top: 16px;
                                                                                                                                                                                                                                      padding: 14px 18px;
                                                                                                                                                                                                                                      border-radius: var(--radius-md);
                                                                                                                                                                                                                                      background: rgba(16, 185, 129, 0.12);
                                                                                                                                                                                                                                      border: 1px solid rgba(16, 185, 129, 0.35);
                                                                                                                                                                                                                                      color: var(--emerald-accent);
                                                                                                                                                                                                                                      border-radius: var(--r-md);
                                                                                                                                                                                                                                      background: rgba(16, 185, 129, 0.1);
                                                                                                                                                                                                                                      border: 1px solid rgba(16, 185, 129, 0.35);
                                                                                                                                                                                                                                      color: #059669;
                                                                                                                                                                                                                                      font-size: 14px;
                                                                                                                                                                                                                                      font-weight: 500;
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .cf-success.show {
                                                                                                                                                                                                                                      display: flex;
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    .form-success.show {
                                                                                                                                                                                                                                      display: flex;
                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                    /* --------------------------------------------------------------------------
   14. FOOTER & SCROLL-TOP
   12. FOOTER
   -------------------------------------------------------------------------- */
                                                                                                                                                                                                                                    footer {
                                                                                                                                                                                                                                      border-top: 1px solid var(--border-subtle);
                                                                                                                                                                                                                                      padding: 48px 0;
                                                                                                                                                                                                                                      background: var(--bg-surface);
                                                                                                                                                                                                                                      position: relative;

                                                                                                                                                                                                                                      .site-footer {
                                                                                                                                                                                                                                        background: var(--text);
                                                                                                                                                                                                                                        padding: 44px 0;
                                                                                                                                                                                                                                        border-top: 1px solid rgba(255, 255, 255, 0.08);
                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                      .footer-inner {
                                                                                                                                                                                                                                        display: flex;
                                                                                                                                                                                                                                        justify-content: space-between;
                                                                                                                                                                                                                                        align-items: center;
                                                                                                                                                                                                                                        flex-wrap: wrap;
                                                                                                                                                                                                                                        gap: 24px;
                                                                                                                                                                                                                                        gap: 20px;
                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                      .footer-brand {
                                                                                                                                                                                                                                        .footer-logo {
                                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                                          align-items: center;
                                                                                                                                                                                                                                          gap: 10px;
                                                                                                                                                                                                                                          gap: 8px;
                                                                                                                                                                                                                                          font-family: var(--font-display);
                                                                                                                                                                                                                                          font-weight: 800;
                                                                                                                                                                                                                                          color: var(--text-primary);
                                                                                                                                                                                                                                          font-size: 18px;
                                                                                                                                                                                                                                          font-size: 16px;
                                                                                                                                                                                                                                          color: #fff;
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-logo .logo-mark {
                                                                                                                                                                                                                                          background: var(--grad-glow);
                                                                                                                                                                                                                                          box-shadow: none;
                                                                                                                                                                                                                                          font-size: 14px;
                                                                                                                                                                                                                                          width: 30px;
                                                                                                                                                                                                                                          height: 30px;
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-copy {
                                                                                                                                                                                                                                          font-size: 14px;
                                                                                                                                                                                                                                          color: rgba(255, 255, 255, 0.45);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-socials {
                                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                                          gap: 10px;
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-socials .cis-btn {
                                                                                                                                                                                                                                          background: rgba(255, 255, 255, 0.08);
                                                                                                                                                                                                                                          border-color: rgba(255, 255, 255, 0.15);
                                                                                                                                                                                                                                          color: rgba(255, 255, 255, 0.7);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-socials .cis-btn:hover {
                                                                                                                                                                                                                                          background: var(--purple);
                                                                                                                                                                                                                                          color: #fff;
                                                                                                                                                                                                                                          border-color: var(--purple);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-copy {
                                                                                                                                                                                                                                          font-size: 14px;
                                                                                                                                                                                                                                          color: var(--text-muted);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .footer-socials {
                                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                                          gap: 12px;
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        /* Scroll-to-top */
                                                                                                                                                                                                                                        .scroll-top {
                                                                                                                                                                                                                                          position: fixed;
                                                                                                                                                                                                                                          bottom: 28px;
                                                                                                                                                                                                                                          right: 28px;
                                                                                                                                                                                                                                          width: 48px;
                                                                                                                                                                                                                                          height: 48px;
                                                                                                                                                                                                                                          bottom: 28px;
                                                                                                                                                                                                                                          right: 28px;
                                                                                                                                                                                                                                          width: 48px;
                                                                                                                                                                                                                                          height: 48px;
                                                                                                                                                                                                                                          border-radius: 50%;
                                                                                                                                                                                                                                          background: var(--grad-signature);
                                                                                                                                                                                                                                          color: #ffffff;
                                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                                          align-items: center;
                                                                                                                                                                                                                                          justify-content: center;
                                                                                                                                                                                                                                          background: var(--grad-main);
                                                                                                                                                                                                                                          color: #fff;
                                                                                                                                                                                                                                          display: flex;
                                                                                                                                                                                                                                          align-items: center;
                                                                                                                                                                                                                                          justify-content: center;
                                                                                                                                                                                                                                          font-size: 16px;
                                                                                                                                                                                                                                          z-index: 900;
                                                                                                                                                                                                                                          opacity: 0;
                                                                                                                                                                                                                                          pointer-events: none;
                                                                                                                                                                                                                                          transform: translateY(12px);
                                                                                                                                                                                                                                          transition: all var(--transition-normal);
                                                                                                                                                                                                                                          box-shadow: var(--shadow-btn);
                                                                                                                                                                                                                                          border: 1px solid rgba(255, 255, 255, 0.2);
                                                                                                                                                                                                                                          transition: all var(--t-mid);
                                                                                                                                                                                                                                          box-shadow: 0 6px 22px rgba(124, 58, 237, 0.45);
                                                                                                                                                                                                                                          border: 2px solid rgba(255, 255, 255, 0.2);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .scroll-top:hover {
                                                                                                                                                                                                                                          transform: translateY(-2px) scale(1.06);
                                                                                                                                                                                                                                          box-shadow: 0 10px 32px rgba(124, 58, 237, 0.6);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .scroll-top.show {
                                                                                                                                                                                                                                          opacity: 1;
                                                                                                                                                                                                                                          pointer-events: auto;
                                                                                                                                                                                                                                          transform: translateY(0);
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        .scroll-top:hover {
                                                                                                                                                                                                                                          transform: translateY(-3px) scale(1.05);
                                                                                                                                                                                                                                          box-shadow: 0 16px 36px -8px rgba(56, 189, 248, 0.65);

                                                                                                                                                                                                                                          /* --------------------------------------------------------------------------
   13. RESPONSIVE
   -------------------------------------------------------------------------- */
                                                                                                                                                                                                                                          @media (max-width: 1024px) {
                                                                                                                                                                                                                                            .hero-inner {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                              gap: 50px;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .hero-visual {
                                                                                                                                                                                                                                              order: -1;
                                                                                                                                                                                                                                              height: 380px;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .hv-orbit {
                                                                                                                                                                                                                                              width: 320px;
                                                                                                                                                                                                                                              height: 320px;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .about-layout {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .edu-layout {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .contact-layout {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .proj-card {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .proj-preview {
                                                                                                                                                                                                                                              border-right: none;
                                                                                                                                                                                                                                              border-bottom: 1px solid var(--border);
                                                                                                                                                                                                                                              min-height: 280px;
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                          .scroll-top.show {
                                                                                                                                                                                                                                            opacity: 1;
                                                                                                                                                                                                                                            pointer-events: auto;
                                                                                                                                                                                                                                            transform: translateY(0);
                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                          @media (max-width: 768px) {

                                                                                                                                                                                                                                            .nav-links,
                                                                                                                                                                                                                                            .nav-cta-btn {
                                                                                                                                                                                                                                              display: none;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .hamburger {
                                                                                                                                                                                                                                              display: flex;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            /* Scroll reveal helper */
                                                                                                                                                                                                                                            .reveal {
                                                                                                                                                                                                                                              opacity: 0;
                                                                                                                                                                                                                                              transform: translateY(26px);
                                                                                                                                                                                                                                              transition: opacity 0.75s var(--ease), transform 0.75s var(--ease);
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            section {
                                                                                                                                                                                                                                              padding: 80px 0;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .hero {
                                                                                                                                                                                                                                              padding-top: 110px;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .hero-stats {
                                                                                                                                                                                                                                              gap: 20px;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .reveal.in {
                                                                                                                                                                                                                                              opacity: 1;
                                                                                                                                                                                                                                              transform: translateY(0);
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .skills-grid {
                                                                                                                                                                                                                                              grid-template-columns: 1fr 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .srv-grid {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .edu-focus-grid {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .cf-row {
                                                                                                                                                                                                                                              grid-template-columns: 1fr;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            /* --------------------------------------------------------------------------
   15. RESPONSIVE BREAKPOINTS
   -------------------------------------------------------------------------- */
                                                                                                                                                                                                                                            @media (max-width: 1080px) {
                                                                                                                                                                                                                                              .hero-inner {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                                gap: 40px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero-visual {
                                                                                                                                                                                                                                                order: -1;
                                                                                                                                                                                                                                                min-height: 400px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .about-grid {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                                gap: 36px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .skills-grid {
                                                                                                                                                                                                                                                grid-template-columns: repeat(2, 1fr);
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .services-grid {
                                                                                                                                                                                                                                                grid-template-columns: repeat(2, 1fr);
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .project-showcase-card {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .project-preview {
                                                                                                                                                                                                                                                border-right: none;
                                                                                                                                                                                                                                                border-bottom: 1px solid var(--border-subtle);
                                                                                                                                                                                                                                                min-height: 280px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .edu-panel {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .edu-left {
                                                                                                                                                                                                                                                border-right: none;
                                                                                                                                                                                                                                                border-bottom: 1px solid var(--border-subtle);
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .contact-grid {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .projects-head {
                                                                                                                                                                                                                                              flex-direction: column;
                                                                                                                                                                                                                                              align-items: flex-start;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            .projects-sub {
                                                                                                                                                                                                                                              text-align: left;
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            @media (max-width: 768px) {

                                                                                                                                                                                                                                              .nav-links,
                                                                                                                                                                                                                                              .nav-cta {
                                                                                                                                                                                                                                                display: none;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .nav-toggle {
                                                                                                                                                                                                                                                display: flex;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              section {
                                                                                                                                                                                                                                                padding: 80px 0;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero {
                                                                                                                                                                                                                                                padding-top: 110px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero-stats {
                                                                                                                                                                                                                                                gap: 24px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .skills-grid {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .services-grid {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .focus-list {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .form-row {
                                                                                                                                                                                                                                                grid-template-columns: 1fr;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .node-card.n1 {
                                                                                                                                                                                                                                                top: 0;
                                                                                                                                                                                                                                                left: 0;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .node-card.n2 {
                                                                                                                                                                                                                                                bottom: 4%;
                                                                                                                                                                                                                                                left: 0;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .node-card.n3 {
                                                                                                                                                                                                                                                top: 12%;
                                                                                                                                                                                                                                                right: 0;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .node-card.n4 {
                                                                                                                                                                                                                                                bottom: 0;
                                                                                                                                                                                                                                                right: 0;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero-ctas {
                                                                                                                                                                                                                                                flex-direction: column;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero-ctas .cta-primary,
                                                                                                                                                                                                                                              .hero-ctas .cta-secondary {
                                                                                                                                                                                                                                                justify-content: center;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .ob-1,
                                                                                                                                                                                                                                              .ob-2,
                                                                                                                                                                                                                                              .ob-3,
                                                                                                                                                                                                                                              .ob-4 {
                                                                                                                                                                                                                                                font-size: 11px;
                                                                                                                                                                                                                                                padding: 6px 10px;
                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                            @media (max-width: 480px) {
                                                                                                                                                                                                                                              .container {
                                                                                                                                                                                                                                                padding: 0 18px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero-actions {
                                                                                                                                                                                                                                                flex-direction: column;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .hero-actions .btn {
                                                                                                                                                                                                                                                width: 100%;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .project-actions {
                                                                                                                                                                                                                                                flex-direction: column;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .project-actions .btn {
                                                                                                                                                                                                                                                width: 100%;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              .about-card,
                                                                                                                                                                                                                                              .contact-info-card,
                                                                                                                                                                                                                                              .contact-form,
                                                                                                                                                                                                                                              .edu-left,
                                                                                                                                                                                                                                              .edu-right,
                                                                                                                                                                                                                                              .project-info-body {
                                                                                                                                                                                                                                                padding: 24px 18px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              @media (max-width: 540px) {
                                                                                                                                                                                                                                                .container {
                                                                                                                                                                                                                                                  padding: 0 18px;
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                .skills-grid {
                                                                                                                                                                                                                                                  grid-template-columns: 1fr;
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                .srv-grid {
                                                                                                                                                                                                                                                  grid-template-columns: 1fr;
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                .hv-frame {
                                                                                                                                                                                                                                                  width: 190px;
                                                                                                                                                                                                                                                  height: 190px;
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                .hv-avatar {
                                                                                                                                                                                                                                                  font-size: 70px;
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                .tc-1,
                                                                                                                                                                                                                                                .tc-2,
                                                                                                                                                                                                                                                .tc-3 {
                                                                                                                                                                                                                                                  display: none;
                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                              }